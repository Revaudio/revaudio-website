---
/**
 * /gas — deliberately ONE SCREEN, and deliberately NOT the shared
 * [slug].astro product layout (Dan, 2026-07-30: "ditch this revlimiter layout
 * idea, make it a one pager the size of a regular laptop"). GAS is free and has
 * one knob; the shared layout gave it 5.3 laptop screens of gallery, sticky
 * feature walkthrough, specs table and install section. Everything a visitor
 * actually needs now sits inside one 1440x900 viewport: what it is, what it
 * costs (nothing), and the download.
 *
 * `getStaticPaths` in [slug].astro skips 'gas' so this file owns the route.
 *
 * Conversion pass (Dan, 2026-09-06: "make it sell more, work with psychology,
 * make it simple"). Every lever here is an honest one:
 *   - copy is the original plugins.ts text (plainHook / tagline / first three
 *     features), Dan 2026-09-06: "keep the old copy, this design is better";
 *   - the three feature lines sit beside the button with brass ticks; the fine
 *     print under it carries formats, platforms and "no licence key";
 *   - the line under the button says the email step BEFORE the modal opens, so
 *     the gate is a known cost and not a surprise at click time;
 *   - one hot focal block: the red CTA (the only red on the page besides the
 *     knob). The video play dot is brass so it does not compete.
 * Nothing invented: no counts, stars, quotes or timers (PRODUCT.md).
 *
 * The CTA speaks TrialGateModal's documented trigger contract (see that
 * component's header) instead of reusing BuyButton: BuyButton's bordered card
 * with a price block and a four-line `includes` list is taller on its own than
 * this entire layout. The non-gated branch is kept so dropping
 * `trialGateActive` in plugins.ts restores the direct download here too.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { plugins, dlGateId } from '../data/plugins';
import { pluginImage } from '../lib/images';
import { site } from '../data/site';

const plugin = plugins.find((p) => p.slug === 'gas')!;
const shot = pluginImage(plugin.heroImage)!;
const registerUrl = site.downloadGate.workerUrl + '/download/register';

/* Search snippet: the plugin name alone ("GAS · RevAudio") tells a searcher
   nothing. Say what it is and that it is free; the description carries the
   formats and the no-catch facts a snippet reader scans for. */
const pageTitle = `${plugin.name}: free one-knob saturator`;
const pageDescription =
  'Free saturator plugin for Windows and macOS (VST3, AU, AAX). One DRIVE knob, three voices: Tube, Tape, Fuzz. Full version, no trial clock, no credit card.';

/* Driver's Manual runtime (YouTube reports 166 s). Stated so the visitor knows
   the cost of clicking before they click. Update if the video is replaced. */
const videoLength = '2:46';

/* The three lines beside the plate are the first three `features` in
   plugins.ts (array order = editorial choice, no second copy to drift). */
const highlights = plugin.features.slice(0, 3);
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage="/og/gas.png">
  <section class="gas">
    <div class="gas-grid">
      {/* eager + high priority: on a one-screen page the plate IS the LCP. */}
      <div class="gas-plate">
        <Image
          src={shot}
          alt={`${plugin.name} plugin interface: one DRIVE knob with Tube, Tape and Fuzz voice buttons`}
          widths={[420, 620, 840]}
          sizes="(max-width: 900px) 62vw, 420px"
          format="webp"
          quality={82}
          loading="eager"
        />
      </div>

      {/* .gas-copy is a named-area grid: on desktop the video badge sits to the
          right of the title block; on phones the areas re-order so the button
          and its fine print land above the fold and the badge comes last. */}
      <div class="gas-copy">
        <div class="gas-titles">
          <h1>
            {plugin.name}
            <span class="gas-free">Free</span>
          </h1>
          {plugin.plainHook && <p class="gas-hook">{plugin.plainHook}</p>}
        </div>

        {plugin.tutorialVideo && (
          <button
            type="button"
            class="gas-video-badge"
            data-gas-video-open
            data-yt-id={plugin.tutorialVideo.youtubeId}
            data-yt-title={`${plugin.name}: ${plugin.tutorialVideo.title}`}
            aria-label={`Play video: ${plugin.name}, ${plugin.tutorialVideo.title}, ${videoLength}`}
          >
            <span class="gas-video-thumb">
              <img
                src={`https://i.ytimg.com/vi/${plugin.tutorialVideo.youtubeId}/hqdefault.jpg`}
                alt=""
                loading="lazy"
                decoding="async"
                width="120"
                height="90"
              />
              <span class="gas-video-play" aria-hidden="true"></span>
            </span>
            <span class="gas-video-caption">{plugin.tutorialVideo.title} &middot; {videoLength}</span>
          </button>
        )}

        <p class="gas-what">{plugin.tagline}.</p>

        <ul class="gas-list">
          {highlights.map((f) => <li>{f.name}</li>)}
        </ul>

        {plugin.trialGateActive ? (
          <button
            type="button"
            class="gas-cta"
            data-trial-gate-open
            data-plugin-name={plugin.name}
            data-plugin-slug={dlGateId(plugin)}
            data-register-url={registerUrl}
            data-gate-free
          >
            Download free
          </button>
        ) : (
          <a class="gas-cta" href={plugin.downloadUrl ?? '/store'}>Download free</a>
        )}

        <p class="gas-fine">
          {plugin.trialGateActive
            ? `${plugin.systemReq.formats} · Windows & macOS · no licence key, we email you the link`
            : `${plugin.systemReq.formats} · Windows & macOS · no licence key`}
        </p>
      </div>
    </div>
  </section>

  {/* Driver's Manual lightbox — the badge next to the title opens this instead
      of an inline 16:9 section, so the one-screen promise above holds. No
      player JS/youtube.com request until the visitor actually clicks play. */}
  {plugin.tutorialVideo && (
    <dialog
      class="gas-video-modal"
      data-gas-video-modal
      aria-label={`${plugin.name}: ${plugin.tutorialVideo.title}`}
    >
      <button type="button" class="gas-video-close" data-gas-video-close aria-label="Close">&times;</button>
      <div class="gas-video-frame" data-gas-video-frame></div>
    </dialog>
  )}
</BaseLayout>

<script>
  const openBtn = document.querySelector<HTMLButtonElement>('[data-gas-video-open]');
  const modal = document.querySelector<HTMLDialogElement>('[data-gas-video-modal]');
  const frame = modal?.querySelector<HTMLElement>('[data-gas-video-frame]');
  const closeBtn = modal?.querySelector<HTMLButtonElement>('[data-gas-video-close]');

  if (openBtn && modal && frame && closeBtn) {
    function openVideo() {
      const id = openBtn!.dataset.ytId;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = openBtn!.dataset.ytTitle ?? '';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      frame!.replaceChildren(iframe);
      if (typeof modal!.showModal === 'function') modal!.showModal(); else modal!.setAttribute('open', '');
      document.documentElement.style.overflow = 'hidden';
    }
    function closeVideo() {
      if (typeof modal!.close === 'function') modal!.close(); else modal!.removeAttribute('open');
    }
    openBtn.addEventListener('click', openVideo);
    closeBtn.addEventListener('click', closeVideo);
    // Backdrop click: a click landing on the dialog element itself (not children).
    modal.addEventListener('click', (e) => { if (e.target === modal) closeVideo(); });
    modal.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      frame!.replaceChildren(); // stop playback once closed
    });
  }
</script>

<style>
  /* One screen, vertically centred. svh (not vh) so mobile browser chrome
     can't push the CTA under the fold. --nav-h is the sticky header token. */
  .gas {
    min-height: calc(100svh - var(--nav-h, 75px));
    display: flex;
    align-items: center;
    padding: var(--space-6) var(--space-5) var(--space-8);
  }

  /* Both columns hug their content and the PAIR is centred. A `1fr` copy column
     looked left-heavy: the copy caps at ~48ch, so the rest of the column was
     dead space pinned to the right edge. */
  .gas-grid {
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: auto auto;
    justify-content: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  /* The plate is portrait, so it is capped by HEIGHT first — that is what keeps
     the page one screen on a short laptop window. Width follows from its ratio. */
  .gas-plate img {
    display: block;
    height: auto;
    width: auto;
    max-width: 100%;
    max-height: min(66svh, 600px);
    filter: drop-shadow(0 24px 60px rgba(0, 0, 0, 0.6));
  }

  /* Named areas so the phone breakpoint can re-order without touching markup:
     the title block and the video badge share a row here; everything else
     spans the full width underneath. */
  .gas-copy {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-areas:
      'titles video'
      'what   what'
      'list   list'
      'cta    cta'
      'fine   fine';
    justify-content: start;
    justify-items: start;
    align-items: center;
    column-gap: var(--space-5);
    row-gap: var(--space-4);
  }

  .gas-titles {
    grid-area: titles;
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  /* ── Driver's Manual badge — small poster thumb + play dot, YouTube's own
     hqdefault crop. Opens the lightbox below; no player JS/request until
     clicked, same click-to-load principle as [slug].astro's full section. ── */
  .gas-video-badge {
    grid-area: video;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .gas-video-thumb {
    position: relative;
    width: 88px;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    overflow: hidden;
    background: #120804;
    border: 1px solid var(--border-bright);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5);
  }

  .gas-video-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.82;
    transition: opacity 0.2s var(--ease), transform 0.3s var(--ease);
  }

  .gas-video-badge:hover .gas-video-thumb img,
  .gas-video-badge:focus-visible .gas-video-thumb img {
    opacity: 1;
    transform: scale(1.05);
  }

  /* Brass, not YouTube red: the CTA is the one warm block on the page and the
     play dot must not out-shout it. Still a circle with a triangle: reads as play. */
  .gas-video-play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--brass);
    border: 2px solid #120804;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.5);
    transition: transform 0.15s var(--ease), background 0.2s var(--ease);
  }

  .gas-video-play::before {
    content: '';
    position: absolute;
    left: 55%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 6px 0 6px 10px;
    border-color: transparent transparent transparent #120804;
  }

  .gas-video-badge:hover .gas-video-play,
  .gas-video-badge:focus-visible .gas-video-play {
    transform: translate(-50%, -50%) scale(1.1);
    background: var(--brass-bright);
  }

  .gas-video-badge:focus-visible {
    outline: 2px solid var(--brass-bright);
    outline-offset: 3px;
    border-radius: 8px;
  }

  .gas-video-caption {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .gas-video-thumb img, .gas-video-play { transition: none; }
  }

  /* ── Driver's Manual lightbox — click-to-play iframe, injected on open and
     torn down on close so nothing plays in the background. ── */
  .gas-video-modal {
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    width: min(860px, 92vw);
  }
  .gas-video-modal[open] { display: block; }
  .gas-video-modal:not([open]) { display: none; }
  .gas-video-modal::backdrop { background: rgba(0, 0, 0, 0.72); backdrop-filter: blur(4px); }

  .gas-video-close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 2;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    background: rgba(10, 8, 4, 0.72);
    color: #fff;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
  .gas-video-close:hover { background: rgba(10, 8, 4, 0.9); color: var(--brass-bright); }

  .gas-video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #120804;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7);
  }
  .gas-video-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .gas-copy h1 {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 7vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: 0.06em;
    color: var(--fg);
  }

  /* Rides up off the baseline so it reads as a stamp ON the wordmark rather
     than a word sitting after it. */
  .gas-free {
    align-self: center;
    translate: 0 -0.15em;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--brass-bright);
    border: 1px solid var(--brass-dark);
    padding: 0.2rem 0.55rem;
    white-space: nowrap;
  }

  .gas-hook {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    letter-spacing: 0.04em;
    color: var(--brass-bright);
  }

  /* Wide enough for the one-liner to land on TWO lines at desktop, breaking
     at its own full stop. */
  .gas-what {
    grid-area: what;
    margin: 0;
    max-width: 48ch;
    text-wrap: balance;
    font-size: var(--text-lg, 1.125rem);
    line-height: 1.5;
    color: var(--fg-dim);
  }

  /* The "what's the catch?" answers. Ticks, not plus signs: these are
     reassurances, not features. */
  .gas-list {
    grid-area: list;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.95rem;
    color: var(--fg);
  }

  .gas-list li {
    padding-left: 1.35rem;
    position: relative;
  }

  .gas-list li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--brass);
    font-weight: 600;
  }

  /* The button, garage edition (Dan 2026-09-06: red, bulky, "make me want to
     press it", then "with the design of the garage"). It is a physical part,
     not a widget (Law 3): a race-red anodized steel pushbutton seated in a
     brass bezel with four screws, each at its own angle (Law 2). Light comes
     from upper-left (Law 4): cream specular on the top lip (never yellow on
     red, §4), dark lip below, contact shadow into the page. Label = cream
     paint stamped into the metal. Hover = the bench lamp swings onto it:
     amber spill that leaks past the bezel + inner red bloom. Press = real
     travel, the body sinks 4px into the bezel. No idle animation: motion is
     feedback only (§3). Race-red on /gas is spent HERE, the one hero element
     on the page (website DESIGN.md §2). */
  .gas-cta {
    grid-area: cta;
    position: relative;
    margin-top: var(--space-2);
    padding: 1.35rem 3.4rem;
    /* brass bezel = the element itself; the red body is ::before */
    background:
      linear-gradient(180deg, var(--brass-bright) 0%, var(--brass) 40%, var(--brass-dark) 100%);
    color: #f3e6c8;
    border: 1px solid #3a2c12;
    border-radius: 12px;
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    isolation: isolate;
    box-shadow:
      inset 0 1px 0 rgba(255,244,208,.45),   /* bezel lip catchlight */
      inset 0 -1px 0 rgba(0,0,0,.6),
      0 1px 0 #050403,                       /* contact */
      0 14px 28px rgba(0,0,0,.55);           /* body shadow into the page */
    transition: transform 0.12s cubic-bezier(.2,.9,.25,1.25), box-shadow 0.12s var(--ease);
  }
  /* the red body: anodized 3-stop + cream top specular + dark lower lip;
     sits 6px inside the bezel; :active sinks it. Wear: faint diagonal
     scratches so it is not one flat fill. */
  .gas-cta::before {
    content: '';
    position: absolute;
    inset: 6px;
    z-index: -1;
    border-radius: 8px;
    background:
      repeating-linear-gradient(115deg, rgba(255,244,208,0) 0 7px, rgba(255,244,208,.045) 7px 8px, rgba(0,0,0,0) 8px 13px, rgba(0,0,0,.08) 13px 14px),
      radial-gradient(120% 140% at 35% 25%, #e83a3a 0%, #b52424 28%, #9e1b1b 62%, #3a0808 100%);
    box-shadow:
      inset 0 2px 0 rgba(255,244,208,.42),   /* cream specular, top lip */
      inset 2px 0 0 rgba(255,244,208,.14),   /* light from the left */
      inset 0 -5px 0 #3a0808,                /* lower lip */
      inset 0 -1px 6px rgba(0,0,0,.5),
      0 3px 0 #2a0606,                       /* seat shadow inside the bezel */
      0 5px 8px rgba(0,0,0,.6);
    transform: translateY(-2px);
    transition: transform 0.12s cubic-bezier(.2,.9,.25,1.25), box-shadow 0.12s var(--ease), filter 0.2s var(--ease);
  }
  /* four screws in the bezel corners, each turned a different few degrees
     (13 / -7 / 19 / -23): perfectly aligned screws read CGI. Head = brass
     radial with a dark slot. */
  .gas-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    border-radius: inherit;
    --screw: radial-gradient(circle at 40% 35%, #f0dca0 0%, #b08d48 45%, #5c4620 72%, rgba(0,0,0,0) 76%);
    --slot: linear-gradient(#3a2c12, #3a2c12);
    background:
      var(--screw) 9px 9px / 9px 9px no-repeat,
      var(--screw) calc(100% - 9px) 9px / 9px 9px no-repeat,
      var(--screw) 9px calc(100% - 9px) / 9px 9px no-repeat,
      var(--screw) calc(100% - 9px) calc(100% - 9px) / 9px 9px no-repeat;
  }
  /* label: cream paint stamped in, thin dark shadow below so it reads
     pressed into the anodize, not printed on top. */
  .gas-cta { text-shadow: 0 1px 0 rgba(0,0,0,.55), 0 -1px 0 rgba(255,244,208,.12); }
  /* hover: the bench lamp swings onto it. Inner red bloom (RevLimiter redline
     state) + amber spill that bleeds past the bezel onto the page. */
  .gas-cta:hover {
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(255,244,208,.55),
      inset 0 -1px 0 rgba(0,0,0,.6),
      0 1px 0 #050403,
      0 16px 32px rgba(0,0,0,.55),
      0 0 0 1px rgba(255,190,100,.18),
      0 0 26px 6px rgba(255,170,70,.22),
      0 0 70px 18px rgba(255,140,50,.12);
  }
  .gas-cta:hover::before {
    filter: brightness(1.12) saturate(1.08);
    box-shadow:
      inset 0 2px 0 rgba(255,244,208,.55),
      inset 2px 0 0 rgba(255,244,208,.18),
      inset 0 -5px 0 #3a0808,
      inset 0 0 8px rgba(232,58,58,.4),
      0 3px 0 #2a0606,
      0 5px 8px rgba(0,0,0,.6);
  }
  /* press: the red body sinks 4px into the bezel, seat shadow collapses,
     the bezel itself returns to rest. */
  .gas-cta:active { transform: translateY(0); }
  .gas-cta:active::before {
    transform: translateY(2px);
    box-shadow:
      inset 0 1px 0 rgba(255,244,208,.25),
      inset 0 -2px 0 #3a0808,
      inset 0 2px 6px rgba(0,0,0,.45),
      0 0 0 #2a0606,
      0 1px 2px rgba(0,0,0,.6);
  }
  .gas-cta:focus-visible { outline: 2px solid var(--brass-bright); outline-offset: 5px; }

  /* Sits directly under the button: the email step named before the click. */
  .gas-fine {
    grid-area: fine;
    margin: 0;
    max-width: none;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
  }

  /* Phones: stack, plate first but smaller. One screen is a desktop promise —
     here the promise is "the button and its fine print sit above the fold".
     The areas re-order: the video badge drops to the end so it never pushes
     the button down. */
  @media (max-width: 900px) {
    .gas {
      min-height: 0;
      padding-top: var(--space-5);
    }

    .gas-grid {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: var(--space-4);
      text-align: center;
    }

    /* 26svh: sized so the button AND the fine print clear the fixed a11y/cart
       FAB band (~64px off the bottom) on a 390x844 phone, the smallest screen
       we care about here. */
    .gas-plate img { max-height: 26svh; }

    .gas-copy {
      grid-template-columns: 1fr;
      grid-template-areas:
        'titles'
        'what'
        'list'
        'cta'
        'fine'
        'video';
      justify-content: center;
      justify-items: center;
      row-gap: var(--space-3);
    }

    .gas-copy h1 { justify-content: center; }
    .gas-what { max-width: 40ch; font-size: 1.05rem; }
    .gas-list { text-align: left; }
    .gas-cta { width: 100%; max-width: 320px; }
    /* nowrap would overflow a phone — let it wrap here. */
    .gas-fine { white-space: normal; max-width: 34ch; }
    .gas-video-badge { margin-top: var(--space-2); }
  }
</style>
