---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with RevAudio for press, partnership, or support."
>
  <section class="plugin-detail">
    <div class="container" style="max-width: 760px;" data-reveal>
      <h1>Get in touch</h1>
      <p class="pitch">
        For press, partnership, demo requests, or just a hello.
      </p>

      <div style="margin-top: 3rem;">
        <div class="spec-row"><span class="key">Email</span><span class="val"><a href="mailto:info@revaudio.net">info@revaudio.net</a></span></div>
        <div class="spec-row"><span class="key">Instagram</span><span class="val"><a href="https://www.instagram.com/revaudioplugins" target="_blank" rel="noopener noreferrer" aria-label="@revaudioplugins on Instagram (opens in new tab)">@revaudioplugins</a></span></div>
        <div class="spec-row"><span class="key">YouTube</span><span class="val"><a href="https://www.youtube.com/@RevAudioPlugins" target="_blank" rel="noopener noreferrer" aria-label="@RevAudioPlugins on YouTube (opens in new tab)">@RevAudioPlugins</a></span></div>
      </div>
    </div>
  </section>
</BaseLayout>
