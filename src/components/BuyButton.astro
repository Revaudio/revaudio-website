---
import { Image } from 'astro:assets';
import type { Plugin } from '../data/plugins';
import { isBuyable, fmtPrice, discountPct, dlGateId } from '../data/plugins';
import { site } from '../data/site';

interface Props {
  plugin: Plugin;
}

const { plugin } = Astro.props;
const buyable = isBuyable(plugin);
const pct = discountPct(plugin);
const registerUrl = site.downloadGate.workerUrl + '/download/register';
---

<div class="buy-block">
  {plugin.trialGateActive ? (
    <>
      <div class:list={['prices', { muted: !plugin.isFree }]}>
        {plugin.isFree ? (
          <span class="price-now">Free</span>
        ) : (
          <span class="price-now">{fmtPrice(plugin.introPriceUsd)}</span>
        )}
      </div>
      <p class="platform-note">Windows &amp; macOS &middot; VST3 / AU</p>
      <button
        type="button"
        class="btn primary"
        data-trial-gate-open
        data-plugin-name={plugin.name}
        data-plugin-slug={dlGateId(plugin)}
        data-register-url={registerUrl}
        {...(plugin.isFree ? { 'data-gate-free': true } : {})}
      >
        {plugin.isFree ? 'Download free' : 'Get the 14-day free trial'}
      </button>
      {plugin.isFree ? (
        <p class="micro muted">Free forever &mdash; we email you the download link.</p>
      ) : (
        <p class="micro muted">Checkout&rsquo;s under construction &mdash; grab the trial while we finish the fix.</p>
      )}
    </>
  ) : plugin.isFree ? (
    <>
      <div class="prices">
        <span class="price-now">Free</span>
      </div>
      <p class="platform-note">Windows &amp; macOS &middot; VST3 / AU</p>
      {plugin.downloadUrl ? (
        <a class="btn primary" href={plugin.downloadUrl}>Download</a>
      ) : (
        <a class="btn primary" href={`/${plugin.slug}#waitlist`}>Email me when the download is ready</a>
      )}
      <p class="micro muted">No account, no licence key &mdash; we email you the download link.</p>
    </>
  ) : buyable ? (
    <>
      <div class="prices">
        <span class="price-now">{fmtPrice(plugin.introPriceUsd)}</span>
        {plugin.regularPriceUsd != null && pct != null ? (
          <>
            <span class="price-was">{fmtPrice(plugin.regularPriceUsd)}</span>
            <span class="price-tag">&minus;{pct}% launch sale</span>
          </>
        ) : (
          <span class="price-tag">Launch price</span>
        )}
      </div>
      {plugin.promoCode && (
        <p class="promo-code-note">
          Save {pct}% &middot; enter code <strong class="code-pill">{plugin.promoCode}</strong> at checkout
        </p>
      )}
      <p class="platform-note">Windows &amp; macOS &middot; VST3 / AU</p>
      <button
        class="btn primary"
        data-add-to-cart
        data-slug={plugin.slug}
        data-name={plugin.name}
        data-price={plugin.regularPriceUsd ?? plugin.introPriceUsd}
        data-checkout-url={plugin.checkoutUrl}
      >
        Add to cart · {fmtPrice(plugin.regularPriceUsd ?? plugin.introPriceUsd)}
      </button>
      {plugin.demoUrl && (
        <a class="btn ghost" href={plugin.demoUrl}>
          Download demo
        </a>
      )}
      <p class="micro muted">Secure checkout &middot; instant delivery.</p>
    </>
  ) : plugin.checkoutPaused ? (
    <>
      <div class="prices">
        <span class="price-now">{fmtPrice(plugin.introPriceUsd)}</span>
        {plugin.regularPriceUsd != null && pct != null && (
          <span class="price-tag">&minus;{pct}% launch</span>
        )}
      </div>
      <p class="platform-note">Windows &amp; macOS &middot; VST3 / AU</p>
      <a class="btn primary" href={`/${plugin.slug}#waitlist`}>Notify me when checkout opens</a>
      <p class="micro muted">We&rsquo;ll email you the moment checkout goes live.</p>
    </>
  ) : plugin.status === 'beta' ? (
    <>
      <div class="prices muted">
        <span class="price-now">{fmtPrice(plugin.introPriceUsd)}</span>
        <span class="price-tag waitlist">Waitlist price</span>
      </div>
      <a class="btn primary" href={`/${plugin.slug}#waitlist`}>
        Join the beta waitlist
      </a>
      <p class="micro muted">Beta builds go to the waitlist first. Launch in {plugin.releaseTarget}.</p>
    </>
  ) : (
    <>
      <div class="prices muted">
        <span class="hint muted">Launch target {plugin.releaseTarget}</span>
      </div>
      <a class="btn primary" href={`/${plugin.slug}#waitlist`}>
        Notify me when {plugin.name} ships
      </a>
    </>
  )}

  {plugin.bundleNote && <p class="bundle-note">{plugin.bundleNote}</p>}

  <ul class="includes">
    {plugin.isFree ? (
      <>
        <li>VST3 / AU (Windows &amp; macOS)</li>
        <li>Free forever &mdash; no licence key</li>
        <li>Free updates</li>
      </>
    ) : (
      <>
        <li>VST3 / AU (Windows &amp; macOS)</li>
        <li>Free updates within v1.x</li>
        <li>Up to 2 machines per licence</li>
        <li>14-day refund</li>
      </>
    )}
  </ul>
</div>

<style>
  .buy-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-top: 3px solid var(--brass);
  }

  .prices {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .prices.muted .price-now { color: var(--fg-dim); }

  .price-now {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--brass-bright);
    letter-spacing: 0.04em;
  }

  .price-was {
    font-family: var(--font-display);
    font-size: 1.875rem;
    color: var(--fg-faint);
    text-decoration: line-through;
    margin-left: -8px;
  }

  .price-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--oxide-text);
    border: 1px solid var(--oxide);
    padding: 0.15rem 0.5rem;
  }

  .price-tag.waitlist {
    color: var(--brass);
    border-color: var(--brass-dark);
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 1.5rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    border: 1px solid transparent;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease), color 0.2s var(--ease);
    cursor: pointer;
  }

  .btn.primary {
    background: var(--brass);
    color: var(--bg-0);
  }
  .btn.primary:hover { background: var(--brass-bright); color: var(--bg-0); }

  .btn.ghost {
    background: transparent;
    color: var(--fg);
    border-color: var(--border-bright);
  }
  .btn.ghost:hover { border-color: var(--brass); color: var(--brass-bright); }

  .btn.link {
    background: transparent;
    color: var(--fg-dim);
    padding: 0.4rem 0;
    text-align: left;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }
  .btn.link:hover { color: var(--brass-bright); }

  .promo-code-note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-dim);
    margin: -0.25rem 0 0;
  }

  .bundle-note {
    font-size: 0.82rem;
    color: var(--brass);
    background: var(--bg-2);
    border: 1px solid var(--brass-dark);
    border-radius: 4px;
    padding: 0.6rem 0.75rem;
    margin: 0;
  }

  .code-pill {
    color: var(--brass-bright);
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .micro { font-size: 0.8rem; margin: 0; }

  .platform-note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--brass);
    margin: 0 0 0.25rem;
  }


  .addcart-btn { width: 100%; max-width: 180px; align-self: center; }

  .includes {
    list-style: none;
    padding: 1rem 0 0;
    margin: 0.5rem 0 0;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--fg-dim);
  }

  .includes li {
    padding: 0.4rem 0;
  }

  .includes li::before {
    content: '+ ';
    color: var(--brass);
    font-weight: 600;
  }
</style>
