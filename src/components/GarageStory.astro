---
/* GarageStory — three windows into the shop (garage homepage pass, 2026-09-06).
   Two photographic plates that bleed to the viewport edge with copy beside
   them, then the truck door on the wood wall with the trial call. Depth the
   way the reference site does it (photos into the dark, not gradients) but
   inside the RevAudio garage (design-language Laws 1, 2, 4).

   Plates: `src/assets/garage/*.jpg` — the car is a frame of the 2026-06
   photoreal teaser (upscaled locally), the unit is the Instagram-era concept
   render of RevLimiter as hardware (its panel predates the shipping UI, so
   it is captioned "Concept render"). Neither is a product screenshot.

   Copy is drawn from PRODUCT.md / CLAUDE.md only: no sound claims the plugin
   source can't back, no invented numbers. The trial button is the same
   delegated [data-trial-gate-open] control as the page-end CTA. */
import { Image } from 'astro:assets';
import GarageWall from './GarageWall.astro';
import carImg from '../assets/garage/car-lamps.jpg';
import unitImg from '../assets/garage/unit-floor.jpg';
import doorImg from '../assets/plugins/revlimiter-crane-master.png';

interface Props {
  pluginName: string;
  trialGateId: string;
  trialRegisterUrl: string;
}
const { pluginName, trialGateId, trialRegisterUrl } = Astro.props;
---

<section class="story" aria-label="Built in a garage">
  <figure class="plate" data-reveal="fade">
    <Image
      src={carImg}
      alt="A black muscle car in a garage at night, exhaust drifting under hanging lamps, a RevLimiter plate on the bumper"
      width={1600}
      widths={[640, 960, 1400]}
      sizes="(max-width: 860px) 100vw, 50vw"
      format="webp"
      quality={80}
      loading="lazy"
    />
  </figure>
  <div class="copy" data-reveal>
    <div class="copy-in">
      <p class="kicker">Built in a garage</p>
      <h2>Tools from the shop floor.</h2>
      <p>
        RevAudio is a small team building plugins around one idea: powerful tools don't need to be
        complicated. Every plugin is a car part you already know how to use. A rev gauge. An AC
        panel. A handbrake.
      </p>
      <p>High quality, simplicity, creativity. That's the whole spec sheet.</p>
    </div>
  </div>
</section>

<section class="story story--flip" aria-label="Read it in one glance">
  <div class="copy" data-reveal>
    <div class="copy-in">
      <p class="kicker">Read it in one glance</p>
      <h2>The redline is the threshold.</h2>
      <p>
        RevLimiter is drawn like a rev gauge, so you never translate numbers into a feeling. Set the
        ceiling and the mix caps there, the way a rev limiter caps an engine at a set point.
      </p>
      <p>Under the needle: multiband compression, saturation and an adaptive limiter, tuned to work as one.</p>
    </div>
  </div>
  <figure class="plate plate--unit" data-reveal="fade">
    <Image
      src={unitImg}
      alt="Concept render of RevLimiter as a brass hardware unit on a garage floor, a muscle car behind it"
      width={2000}
      widths={[640, 960, 1400, 2000]}
      sizes="(max-width: 860px) 100vw, 50vw"
      format="webp"
      quality={80}
      loading="lazy"
    />
    <figcaption>Concept render</figcaption>
  </figure>
</section>

<GarageWall ariaLabel="Honest by design">
  <div class="story story--wall">
    <figure class="door" data-reveal="card">
      <Image
        src={doorImg}
        alt=""
        width={480}
        widths={[360, 480, 720]}
        sizes="(max-width: 860px) 60vw, 24vw"
        format="webp"
        quality={86}
        loading="lazy"
      />
      <span class="door-paint" aria-hidden="true"><b>30 days</b><i>full version</i></span>
    </figure>
    <div class="copy" data-reveal>
      <div class="copy-in">
        <p class="kicker">Honest by design</p>
        <h2>Try the full thing first.</h2>
        <p>
          The trial is the full version of {pluginName} for 30 days. No credit card, no cut-down
          demo. If it earns a place in your chain, buy it. If not, there's nothing to cancel.
        </p>
        <button
          type="button"
          class="trial-cta"
          data-trial-gate-open
          data-plugin-name={pluginName}
          data-plugin-slug={trialGateId}
          data-register-url={trialRegisterUrl}
          aria-label={`Start the free 30-day trial of ${pluginName}, full version, no credit card`}
        >
          <span class="tc-verb">Start your 30-day free trial</span>
          <span class="tc-micro">{pluginName} &middot; full version &middot; no credit card</span>
        </button>
      </div>
    </div>
  </div>
</GarageWall>

<style>
  /* ── row ── */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
  }

  /* ── plates: windows into the shop. The photo fills the cell, every edge
     vignettes into the page dark so the plate reads as a hole in the wall,
     not a card on it. ── */
  .plate {
    position: relative;
    margin: 0;
    min-height: clamp(380px, 46vw, 680px);
    overflow: hidden;
    background: var(--bg-1);
  }
  .plate img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
    display: block;
  }
  .plate--unit img { object-position: 50% 55%; }
  .plate::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 96px 12px var(--bg-0);
  }
  .plate figcaption {
    position: absolute;
    right: 1rem;
    bottom: 0.85rem;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  /* ── copy ── */
  .copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.5rem, 6vw, 5.5rem) clamp(1.25rem, 6vw, 6rem);
  }
  .copy-in { max-width: 34rem; }
  .story--flip .copy-in { margin-left: auto; }

  .kicker {
    margin: 0 0 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--brass);
    text-shadow: var(--engrave-fine, 0 1px 0 rgba(0, 0, 0, 1));
  }
  .copy h2 {
    margin: 0 0 1.1rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.6rem, 4.6vw, 4.4rem);
    line-height: 0.95;
    letter-spacing: 0.02em;
    color: var(--fg);
    /* on the wood the wall's engrave token wins; on the page dark, a shallow cut */
    text-shadow: var(--engrave, 0 -1px 0 rgba(0, 0, 0, 1), 0 1px 0 rgba(198, 156, 104, 0.35));
  }
  .copy p {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--fg);
    opacity: 0.86;
  }
  .story--wall .copy p { text-shadow: var(--engrave-fine); }

  /* ── the door on the wall ── */
  .story--wall { padding: clamp(1.5rem, 4vw, 3.5rem) clamp(1rem, 4vw, 2.5rem); }
  .door {
    position: relative;
    margin: 0;
    width: min(72%, 380px);
    justify-self: center;
    align-self: center;
    container-type: inline-size;
  }
  .door img {
    display: block;
    width: 100%;
    height: auto;
    filter:
      drop-shadow(0 1px 0 rgba(0, 0, 0, 1))
      drop-shadow(0 26px 40px rgba(0, 0, 0, 0.62));
    transition: transform 120ms cubic-bezier(0.2, 0.9, 0.25, 1.25);
  }
  .door:hover img { transform: translateY(-1px); }
  /* painted on the door — percentages of the door, scales with it (cqw) */
  .door-paint {
    position: absolute;
    left: 20%;
    right: 8%;
    top: 54%;
    text-align: center;
    text-transform: uppercase;
    pointer-events: none;
  }
  .door-paint b {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 14cqw;
    line-height: 1;
    color: rgba(239, 233, 223, 0.86);
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.7);
  }
  .door-paint i {
    display: block;
    margin-top: 0.5em;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 4.6cqw;
    letter-spacing: 0.28em;
    color: var(--brass-bright);
    opacity: 0.92;
  }

  /* ── trial button: same enamel plate as the page end ── */
  .trial-cta {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.5rem;
    padding: 0.95rem 2.1rem;
    border: 0;
    border-radius: 4px;
    background: var(--brass-bright);
    color: var(--bg-0);
    text-shadow: none;
    cursor: pointer;
    box-shadow:
      0 1px 0 0 #000,
      0 10px 24px rgba(0, 0, 0, 0.5);
    transition: filter 0.2s var(--ease), transform 0.12s var(--ease);
  }
  .trial-cta:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .trial-cta:active { filter: brightness(0.95); transform: translateY(0); }
  .tc-verb {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.06em;
    line-height: 1;
  }
  .tc-micro {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  /* ── one column: plate first, then the words ── */
  @media (max-width: 860px) {
    .story { grid-template-columns: 1fr; }
    .plate { min-height: clamp(300px, 70vw, 520px); }
    .story--flip .plate { order: -1; }
    .story--flip .copy-in { margin-left: 0; }
    .copy { padding: 2rem 1.25rem 2.5rem; }
    .door { width: min(64%, 300px); margin-bottom: 0.5rem; }
  }

  /* phones: the wall row gives its side padding to the copy so the button keeps
     "Start your 30-day free trial" on one line */
  @media (max-width: 480px) {
    .story--wall { padding-inline: 0; }
    .trial-cta { width: 100%; padding-inline: 1rem; }
    .tc-verb { font-size: 1.35rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .door img, .trial-cta { transition: none; }
  }

  :global(html.hc) .plate::after { display: none; }
  :global(html.hc) .copy p { opacity: 1; }
</style>
