---
/**
 * TrialGateModal — popup shown instead of Buy/Download while checkout is
 * paused for a plugin (Plugin.trialGateActive in plugins.ts, set during the
 * payment-provider migration). Render once in BaseLayout; any element with
 * [data-trial-gate-open] opens it (event delegation — same pattern as
 * SubscribeModal), reading off the trigger:
 *   data-plugin-name  — plugin display name, drops into the copy
 *   data-gate-free    — present on FREE-forever plugins (GAS): the copy drops
 *                        every "trial" / "checkout's under construction"
 *                        mention — it's not a trial, there's no checkout to
 *                        miss. Same form, same register flow.
 *   data-plugin-slug  — sent to the register endpoint as {plugin}. Must be
 *                        the license worker's flat id (dlGateId in
 *                        plugins.ts), NOT the site slug — the worker treats
 *                        unknown ids as revlimiter.
 *   data-register-url — POST target. LIVE (2026-07-26): every trigger passes
 *                        site.downloadGate.workerUrl + '/download/register'
 *                        (the license worker's CORS-open email gate). A
 *                        trigger without it still gets the honest "not live
 *                        yet" message (SubscribeModal's `wired` pattern).
 *
 * Three states, one dialog:
 *   1. form  — email capture (the trigger path above).
 *   2. sent  — "check your inbox".
 *   3. ready — Mac + Windows buttons. Reached WITHOUT a trigger: the emailed
 *              verify link bounces back to this page as #dl=<gate token>&p=<gate
 *              id> (license worker handleDownloadVerify) — a fragment, so the
 *              token never reaches a server log — and the params are stripped
 *              from the URL as soon as they're read. The buttons hit
 *              the SAME license worker that already serves every build out of
 *              R2 — POST /download {plugin, os, gate} mints a 15-min /dl token,
 *              we navigate to it, the worker streams the object. No second
 *              worker, and no copy of the R2 key map on the site: `os` is
 *              "win"/"mac" and the worker's own registry resolves it, so a
 *              release that renames a build never needs a site deploy.
 */
import { plugins, dlGateId } from '../data/plugins';
import { site } from '../data/site';

const workerUrl = site.downloadGate.workerUrl;
// Gate id -> display name. The ready state has no trigger element to read the
// name off, so it comes from the same source the triggers use.
const gateNames = Object.fromEntries(plugins.map((p) => [dlGateId(p), p.name]));
---

<dialog
  class="tg-modal"
  data-tg-modal
  aria-label="Get the free trial"
  data-tg-worker={workerUrl}
  data-tg-names={JSON.stringify(gateNames)}
>
  <button type="button" class="tg-x" data-tg-close aria-label="Close">&times;</button>
  <p class="tg-kicker" data-tg-kicker>Free 30-day trial</p>
  <h2 data-tg-title>Take the free trial</h2>
  <p class="tg-sub" data-tg-sub>
    Download 30 days free first, full version, no credit card. Verify your email and the download link lands in your inbox.
  </p>
  <form class="tg-form" data-tg-form novalidate>
    <label class="tg-field">
      <span>Email</span>
      <input type="email" data-tg-email name="email" placeholder="you@studio.com" required autocomplete="email" />
    </label>
    <!-- honeypot: real users never fill this; bots do -->
    <input type="text" name="_gotcha" class="tg-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <!-- Marketing consent: UNCHECKED by default (Soundtoys pattern) — the
         download never depends on it; ticking it is a real, separate yes.
         Posted as {marketing} — the worker may ignore it until the list side
         is wired, the signal is captured either way. -->
    <label class="tg-consent">
      <input type="checkbox" data-tg-consent />
      <span>Also send me new-plugin drops and demo codes (optional)</span>
    </label>
    <button type="submit" class="tg-submit" data-tg-submit>Send my link</button>
    <p class="tg-err" data-tg-err role="alert" aria-live="polite"></p>
  </form>
  <p class="tg-status" data-tg-status role="status" aria-live="polite" hidden></p>
  <div class="tg-ready" data-tg-ready hidden>
    <div class="tg-dl-row" data-tg-dl-row>
      <button type="button" class="tg-dl" data-tg-dl="mac">
        <span class="tg-dl-os">macOS</span>
        <span class="tg-dl-fmt">.pkg installer</span>
      </button>
      <button type="button" class="tg-dl" data-tg-dl="win">
        <span class="tg-dl-os">Windows</span>
        <span class="tg-dl-fmt">.exe installer</span>
      </button>
    </div>
    <p class="tg-dl-note" data-tg-dl-note role="status" aria-live="polite" hidden></p>
    <button type="button" class="tg-dl-again" data-tg-dl-again hidden>Didn&rsquo;t start? Try again</button>
    <p class="tg-mobile-note" data-tg-mobile hidden>
      These are desktop installers. Open the link from your email on your Mac or PC &mdash; it&rsquo;s good for 24 hours.
    </p>
    <p class="tg-err" data-tg-dl-err role="alert" aria-live="polite"></p>
  </div>
</dialog>

<script>
  (function () {
    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    var modal = document.querySelector('[data-tg-modal]');
    if (!modal) return;
    var html = document.documentElement;
    var kicker = modal.querySelector('[data-tg-kicker]');
    var sub = modal.querySelector('[data-tg-sub]');
    var title = modal.querySelector('[data-tg-title]');
    var form = modal.querySelector('[data-tg-form]');
    var email = modal.querySelector('[data-tg-email]');
    var submit = modal.querySelector('[data-tg-submit]');
    var err = modal.querySelector('[data-tg-err]');
    var status = modal.querySelector('[data-tg-status]');
    var ready = modal.querySelector('[data-tg-ready]');
    var dlErr = modal.querySelector('[data-tg-dl-err]');
    var dlRow = modal.querySelector('[data-tg-dl-row]');
    var dlNote = modal.querySelector('[data-tg-dl-note]');
    var dlAgain = modal.querySelector('[data-tg-dl-again]');
    var mobileNote = modal.querySelector('[data-tg-mobile]');
    var againTimer = 0;

    var worker = modal.getAttribute('data-tg-worker') || '';
    var names = {};
    try { names = JSON.parse(modal.getAttribute('data-tg-names') || '{}'); } catch (e) {}

    var registerUrl = '';
    var pluginSlug = '';
    var gateToken = '';
    var inFlight = false;
    var dlInFlight = false;

    function show() {
      if (typeof modal.showModal === 'function') modal.showModal(); else modal.setAttribute('open', '');
      html.style.overflow = 'hidden';
    }

    function open(trigger) {
      var name = trigger.getAttribute('data-plugin-name') || 'RevAudio';
      pluginSlug = trigger.getAttribute('data-plugin-slug') || '';
      registerUrl = trigger.getAttribute('data-register-url') || '';
      var free = trigger.hasAttribute('data-gate-free');
      kicker.hidden = free;
      // "Checkout's under construction" retired 2026-08-03 — checkout is live
      // again; this modal is now purely the trial/free-download email gate.
      kicker.textContent = 'Free 30-day trial';
      title.textContent = free
        ? name + ' is free — grab it'
        : 'Take the free ' + name + ' trial';
      sub.textContent = free
        ? 'Free forever. Full version, no trial clock, no credit card. Verify your email and the download link lands in your inbox.'
        : 'Download 30 days free first, full version, no credit card. Verify your email and the download link lands in your inbox.';
      form.hidden = false;
      status.hidden = true;
      ready.hidden = true;
      err.textContent = '';
      email.value = '';
      email.disabled = false;
      submit.disabled = false;
      show();
      email.focus();
    }

    // State 3 — arrived back from the verify email. No trigger element here, so
    // the plugin identity comes from the URL and the copy from the name map.
    function openReady(pluginId, gate) {
      pluginSlug = pluginId;
      gateToken = gate;
      registerUrl = worker + '/download/register'; // so an expired token can re-register
      var name = names[pluginId] || 'your plugin';
      kicker.hidden = false;
      kicker.textContent = 'Email verified';
      title.textContent = 'Download ' + name;
      form.hidden = true;
      status.hidden = true;
      ready.hidden = false;
      dlErr.textContent = '';
      dlNote.hidden = true;
      dlAgain.hidden = true;
      // Phones/tablets can't run a .pkg/.exe — hide the buttons and say why
      // instead of serving a guaranteed-wasted download. The emailed link
      // carries the gate token, so “open it on your computer” really works.
      // The sub swaps too: “pick your platform” reads as broken with no buttons.
      var coarse = false;
      try { coarse = window.matchMedia('(pointer: coarse)').matches; } catch (e) {}
      sub.textContent = coarse
        ? 'Full version, no key needed \u2014 this one just needs a computer.'
        : 'Full version, no key needed. Pick your platform \u2014 the installer lands in your browser\u2019s Downloads folder. Grab both if you work on two machines.';
      dlRow.hidden = coarse;
      mobileNote.hidden = !coarse;
      show();
      // Otherwise the dialog autofocuses the close button — a focus ring on the
      // ✕ is the first thing a verified visitor sees.
      var first = ready.querySelector('[data-tg-dl]');
      if (first && !coarse) first.focus();
      // openReady has exactly one caller (the return-leg block below, itself
      // gated on dlToken+dlPlugin and run once per page load), so this fires
      // once per genuine verify-link redirect — never on a plain page load,
      // never on re-toggling the modal. Guarded: gtag only exists once cookie
      // consent has been granted (CookieBanner.astro), same pattern as the
      // trial-start conversions in TrialPlates.astro / TrialStamp.astro.
      if (pluginId === 'radioroulette' && window.gtag) {
        window.gtag('event', 'conversion', { send_to: 'AW-18334323184/0IbICJaOgeEcEPCjvqZE' });
      }
    }
    function close() {
      if (typeof modal.close === 'function') modal.close(); else modal.removeAttribute('open');
    }
    modal.addEventListener('close', function () { html.style.overflow = ''; });

    document.addEventListener('click', function (e) {
      var t = e.target.closest && e.target.closest('[data-trial-gate-open]');
      if (t) { e.preventDefault(); open(t); }
    });
    var closeBtn = modal.querySelector('[data-tg-close]');
    if (closeBtn) closeBtn.addEventListener('click', close);
    // Backdrop click: a click landing on the dialog element itself (not children).
    modal.addEventListener('click', function (e) { if (e.target === modal) close(); });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (inFlight) return;
      var v = email.value.trim();
      if (!EMAIL_RE.test(v)) {
        err.textContent = 'That doesn’t look like an email.';
        email.focus();
        return;
      }
      if (!registerUrl) {
        err.textContent = '';
        form.hidden = true;
        status.textContent = 'Almost there — the trial download goes live shortly. Your email wasn’t sent yet.';
        status.hidden = false;
        return;
      }
      inFlight = true;
      submit.disabled = true;
      err.textContent = '';
      var consent = modal.querySelector('[data-tg-consent]');
      fetch(registerUrl, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email: v, plugin: pluginSlug, marketing: !!(consent && consent.checked) }),
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data && data.ok) {
            form.hidden = true;
            status.textContent = 'Check your inbox — we sent the download link to ' + v + '.';
            status.hidden = false;
            // Registration really happened — lets listeners (the exit popup's
            // "already got it" suppression) key off the true success moment
            // instead of a CTA click that might be abandoned at this form.
            document.dispatchEvent(new CustomEvent('tg:registered', { detail: { plugin: pluginSlug } }));
          } else {
            err.textContent = (data && data.error) || 'Something went wrong. Try again.';
          }
        })
        .catch(function () {
          err.textContent = 'Network hiccup. Try again in a moment.';
        })
        .finally(function () {
          inFlight = false;
          submit.disabled = false;
        });
    });

    // ---- state 3: the download buttons -------------------------------------
    // Both hit the license worker that already fronts the R2 bucket. It answers
    // {ok, url:"/dl?t=..."} — a 15-minute token — and that URL responds with
    // Content-Disposition: attachment, so navigating to it starts the download
    // and leaves this page (and this dialog) exactly where it is.
    // Success is a TERMINAL state. /dl answers Content-Disposition: attachment,
    // so the page never navigates and nothing on screen used to change — which
    // is exactly why people clicked again (the multi-download bug). The clicked
    // button locks into “Downloading…”, its sibling stays live (grab both is
    // legit), and a quiet re-arm link appears after 8s for genuine misfires.
    function markDownloading(btn) {
      var os = btn.querySelector('.tg-dl-os');
      var fmt = btn.querySelector('.tg-dl-fmt');
      if (!btn.getAttribute('data-tg-orig')) btn.setAttribute('data-tg-orig', os.textContent + '|' + fmt.textContent);
      btn.classList.add('tg-dl-done');
      btn.disabled = true;
      os.textContent = 'Downloading…';
      fmt.textContent = 'check your Downloads folder';
      dlNote.textContent = 'Download started — check your browser’s Downloads folder.';
      dlNote.hidden = false;
      // One shared re-arm link, 8s after the LAST click; it restores every
      // locked button (grab-both clicks share it).
      if (againTimer) clearTimeout(againTimer);
      againTimer = setTimeout(function () { dlAgain.hidden = false; }, 8000);
    }
    dlAgain.addEventListener('click', function () {
      var done = ready.querySelectorAll('.tg-dl-done');
      for (var i = 0; i < done.length; i++) {
        var parts = (done[i].getAttribute('data-tg-orig') || '|').split('|');
        done[i].querySelector('.tg-dl-os').textContent = parts[0];
        done[i].querySelector('.tg-dl-fmt').textContent = parts[1];
        done[i].classList.remove('tg-dl-done');
        done[i].disabled = false;
      }
      if (againTimer) { clearTimeout(againTimer); againTimer = 0; }
      dlAgain.hidden = true;
      dlNote.hidden = true;
      dlNote.textContent = '';
      var first = ready.querySelector('[data-tg-dl]');
      if (first) first.focus();
    });
    ready.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('[data-tg-dl]');
      if (!btn || btn.disabled || dlInFlight) return;
      dlInFlight = true;
      btn.disabled = true;
      dlErr.textContent = '';
      fetch(worker + '/download', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ plugin: pluginSlug, os: btn.getAttribute('data-tg-dl'), gate: gateToken }),
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data && data.ok && data.url) {
            // Lock BEFORE navigating — the attachment response leaves the page
            // (and this dialog) in place, so the locked state is what they see.
            markDownloading(btn);
            window.location.href = worker + data.url;
          } else if (data && data.locked) {
            // 24h gate token aged out — fall back to the email form so they can
            // mint a fresh link instead of hitting a dead end.
            btn.disabled = false;
            ready.hidden = true;
            form.hidden = false;
            kicker.hidden = true;
            title.textContent = 'That link expired';
            sub.textContent = 'Verify links are good for 24 hours. Enter your email and we’ll send a fresh one.';
            email.value = '';
            email.disabled = false;
            submit.disabled = false;
            email.focus();
          } else {
            btn.disabled = false;
            dlErr.textContent = (data && data.error) || 'Something went wrong. Try again.';
          }
        })
        .catch(function () {
          btn.disabled = false;
          dlErr.textContent = 'Network hiccup. Try again in a moment.';
        })
        .finally(function () {
          // Failures re-arm the clicked button above; after a success the
          // terminal state owns the disable. Sibling stays clickable either way.
          dlInFlight = false;
        });
    });

    // Return leg: /revlimiter#dl=<token>&p=<gate id>. The fragment is never sent
    // to a server, so the token stays out of the site's and Cloudflare's access
    // logs; the query-string form is still read as a fallback for links minted
    // before the worker moved to fragments. Read once, then scrub the params out
    // of the address bar so the token isn't sitting there to be copied, shared,
    // or handed to the next page in the Referer.
    var hashQ = new URLSearchParams(window.location.hash.replace(/^#/, ''));
    var searchQ = new URLSearchParams(window.location.search);
    var fromHash = !!(hashQ.get('dl') && hashQ.get('p'));
    var src = fromHash ? hashQ : searchQ;
    var dlToken = src.get('dl');
    var dlPlugin = src.get('p');
    if (dlToken && dlPlugin) {
      src.delete('dl');
      src.delete('p');
      // Only rebuild the hash when it was ours — a plain anchor (#features) has
      // to survive verbatim, and round-tripping it through URLSearchParams would
      // rewrite it to "features=".
      var restSearch = searchQ.toString();
      var restHash = fromHash ? hashQ.toString() : window.location.hash.replace(/^#/, '');
      history.replaceState(null, '', window.location.pathname
        + (restSearch ? '?' + restSearch : '')
        + (restHash ? '#' + restHash : ''));
      openReady(dlPlugin, dlToken);
    }
  })();
</script>

<style>
  .tg-modal {
    margin: auto;
    width: min(440px, calc(100vw - 2.5rem));
    padding: 2rem 2rem 1.75rem;
    background: var(--bg-1);
    color: var(--fg);
    border: 1px solid var(--border-bright);
    border-top: 3px solid var(--brass);
    border-radius: 12px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7);
  }
  .tg-modal::backdrop { background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(4px); }

  :global(html.motion-ok) .tg-modal[open] {
    animation: tg-in 0.45s var(--ease-settle) both;
  }
  :global(html.motion-ok) .tg-modal[open]::backdrop {
    animation: tg-fade 0.3s var(--ease) both;
  }
  @keyframes tg-in { from { opacity: 0; transform: scale(0.94) translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes tg-fade { from { opacity: 0; } to { opacity: 1; } }

  .tg-x {
    position: absolute;
    top: 0.6rem;
    right: 0.75rem;
    border: 0;
    background: transparent;
    color: var(--fg-dim);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.25rem;
  }
  .tg-x:hover { color: var(--brass-bright); }

  .tg-kicker {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--oxide-text);
    margin: 0 0 0.5rem;
  }

  .tg-modal h2 {
    font-family: var(--font-display);
    letter-spacing: 0.04em;
    color: var(--brass-bright);
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
    line-height: 1.15;
  }

  .tg-sub { color: var(--fg-dim); font-size: 0.92rem; margin: 0 0 1.5rem; }

  .tg-form { display: flex; flex-direction: column; gap: 1rem; }
  /* An author `display` beats the UA's [hidden] rule, so form.hidden alone left
     the email field on screen underneath the "check your inbox" line (and the
     download buttons). Restate it at class+attribute specificity. */
  .tg-form[hidden] { display: none; }

  .tg-field { display: flex; flex-direction: column; gap: 0.35rem; }
  .tg-field span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-dim);
  }
  .tg-field input {
    background: var(--bg-0);
    border: 1px solid var(--border-bright);
    border-radius: 6px;
    color: var(--fg);
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.7rem 0.85rem;
  }
  .tg-field input:focus-visible { outline: 2px solid var(--brass-bright); outline-offset: 0; border-color: var(--brass-dark); }

  .tg-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .tg-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--fg-dim);
    cursor: pointer;
  }
  .tg-consent input {
    margin: 0.15rem 0 0;
    accent-color: var(--brass);
    flex: none;
  }
  .tg-consent input:focus-visible { outline: 2px solid var(--brass-bright); outline-offset: 2px; }

  .tg-submit {
    display: block;
    width: 100%;
    padding: 0.85rem 1.5rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    border: 1px solid transparent;
    background: var(--brass);
    color: var(--bg-0);
    cursor: pointer;
    transition: background 0.2s var(--ease);
  }
  .tg-submit:hover { background: var(--brass-bright); }
  .tg-submit:disabled { opacity: 0.6; cursor: default; }

  .tg-err { min-height: 1.1em; margin: 0; font-size: 0.8rem; color: var(--oxide-text); }

  .tg-status { margin: 0; font-size: 0.95rem; text-align: center; color: var(--brass-bright); }

  /* state 3 — platform buttons. Equal weight on purpose: we don't sniff the OS,
     and a producer on two machines wants both. */
  .tg-dl-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  @media (max-width: 380px) { .tg-dl-row { grid-template-columns: 1fr; } }

  .tg-dl {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.9rem 0.75rem;
    background: var(--bg-0);
    border: 1px solid var(--border-bright);
    border-radius: 6px;
    color: var(--fg);
    cursor: pointer;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .tg-dl:hover { border-color: var(--brass); background: var(--bg-1); }
  .tg-dl:focus-visible { outline: 2px solid var(--brass-bright); outline-offset: 2px; }
  .tg-dl:disabled { opacity: 0.6; cursor: default; }
  /* Post-click TERMINAL state — reads as confirmed, not as a faded dead
     button (a faded button reads as “nothing happened” → the multi-click bug). */
  .tg-dl.tg-dl-done { opacity: 1; border-color: var(--brass); cursor: default; }
  .tg-dl.tg-dl-done .tg-dl-os { color: var(--brass-bright); }

  .tg-dl-note { color: var(--fg-dim); font-size: 0.82rem; margin: 0.75rem 0 0; }
  .tg-dl-note[hidden] { display: none; }

  .tg-dl-again {
    display: block;
    margin: 0.5rem 0 0;
    padding: 0;
    background: none;
    border: 0;
    color: var(--fg-dim);
    font-family: var(--font-body);
    font-size: 0.8rem;
    text-decoration: underline;
    cursor: pointer;
  }
  .tg-dl-again[hidden] { display: none; }
  .tg-dl-again:hover { color: var(--brass-bright); }
  .tg-dl-again:focus-visible { outline: 2px solid var(--brass-bright); outline-offset: 2px; }

  /* Author display beats [hidden] — same trap as .tg-form above. */
  .tg-dl-row[hidden] { display: none; }
  .tg-mobile-note { color: var(--fg-dim); font-size: 0.92rem; margin: 0; }
  .tg-mobile-note[hidden] { display: none; }

  .tg-dl-os {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brass-bright);
  }
  .tg-dl-fmt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--fg-dim);
  }
</style>
