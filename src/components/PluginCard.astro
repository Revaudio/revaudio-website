---
import { Image } from 'astro:assets';
import type { Plugin } from '../data/plugins';
import { fmtPrice, discountPct, isBuyable, dlGateId } from '../data/plugins';
import { pluginImage } from '../lib/images';
import { site } from '../data/site';
import StarRating from './StarRating.astro';

interface Props {
  plugin: Plugin;
  cta?: string;
  /** Store grid: show an inline "Add to cart" button beside the CTA (buyable only). */
  showCart?: boolean;
}

const { plugin, cta, showCart = false } = Astro.props;
const buyable = isBuyable(plugin);
const pct = discountPct(plugin);
const thumb = pluginImage(plugin.heroImage);
// The "coming soon" plate is a true-alpha graphic, not a screenshot — float it
// frameless on the card instead of letterboxing it in the dark screenshot box
// (which left black bars either side of the narrower plate).
const isPlate = plugin.heroImage === 'coming-soon-plate.png';
const isBare = !!plugin.cardThumbBare;
// Per-plugin styled titles — same colorways as the homepage carousel
// (PluginShowcase): Rev red, DRIFT gradient, AC ice, GAS fuel-glass,
// Radio Roulette felt/red/black. Unknown slugs fall back to the plain name.
const TITLE_FX: Record<string, { html: string; cls: string }> = {
  revlimiter: { html: '<span class="rev">Rev</span>Limiter', cls: '' },
  drift: { html: 'DRIFT', cls: 'drift' },
  'the-ac': { html: '<span class="acthe">THE</span> <span class="acac">AC</span>', cls: '' },
  gas: { html: 'GAS', cls: 'gas' },
  'radio-roulette': {
    html: 'RADIO <span class="rr-red">ROUL</span><span class="rr-blk">ETTE</span>',
    cls: '',
  },
};
const titleFx = TITLE_FX[plugin.slug];
const gated = !!plugin.trialGateActive;
// Live email gate: TrialGateModal POSTs {email, plugin} here (plugin = the
// worker's flat id, hence dlGateId — 'radio-roulette' would silently register
// as revlimiter otherwise, the worker defaults unknown ids).
const registerUrl = site.downloadGate.workerUrl + '/download/register';
const thumbStyle = [
  plugin.cardThumbAspect ? `aspect-ratio:${plugin.cardThumbAspect};` : '',
  plugin.cardThumbMaxWidthPct ? `max-width:${plugin.cardThumbMaxWidthPct}%; margin-inline:auto;` : '',
].join('') || undefined;
---

<div class="plugin-card-wrap">
<a class="plugin-card" href={`/${plugin.slug}`} data-reveal="card">
  <div
    class:list={['card-thumb', { 'is-plate': isPlate, 'is-bare': isBare }]}
    style={thumbStyle}
  >
    {thumb ? (
      // Responsive variants so phones fetch a card-sized file, not the full
      // 1600px master. Card is ~1 column on phones (≤1020px) and ~1/3 of the
      // grid on desktop; at DPR2 the 800px variant covers the phone card.
      <Image
        src={thumb}
        alt={plugin.name}
        width={1600}
        widths={[400, 800, 1600]}
        sizes="(max-width: 1020px) 92vw, 30vw"
        format="webp"
        quality={92}
        loading="lazy"
      />
    ) : (
      <span class="thumb-placeholder">{plugin.name}</span>
    )}
  </div>
  {titleFx ? (
    <h3 class={`title-fx ${titleFx.cls}`} set:html={titleFx.html} />
  ) : (
    <h3>{plugin.name}</h3>
  )}
  <p class="one-liner">{plugin.oneLiner}</p>
  <StarRating rating={plugin.reviewsAvg} count={plugin.reviewsCount} scale={0.9} />
  <div class="prices" data-reveal-accent>
    {plugin.isFree ? (
      <span class="now">Free</span>
    ) : buyable ? (
      pct != null ? (
        <>
          <span class="now">{fmtPrice(plugin.introPriceUsd)}</span>
          <span class="was">{fmtPrice(plugin.regularPriceUsd)}</span>
          <span class="pct">&minus;{pct}% launch sale</span>
          {plugin.promoCode && <span class="promo-hint">code {plugin.promoCode}</span>}
        </>
      ) : (
        <span class="now">{fmtPrice(plugin.introPriceUsd)}</span>
      )
    ) : plugin.checkoutPaused ? (
      <>
        <span class="now">{fmtPrice(plugin.introPriceUsd)}</span>
        <span class="hint muted">Available soon</span>
      </>
    ) : plugin.status === 'beta' ? (
      <>
        <span class="now muted-now">{fmtPrice(plugin.introPriceUsd)}</span>
        <span class="hint muted">Launch price &middot; subscribe for it</span>
      </>
    ) : (
      <span class="hint muted">Target {plugin.releaseTarget}</span>
    )}
  </div>
  {plugin.bundleNote && <p class="bundle-hint">{plugin.bundleNote}</p>}
  <span class="more">{cta ?? (
    plugin.isFree ? 'Free download' :
    buyable ? 'View & buy' :
    plugin.checkoutPaused ? 'Notify me' :
    plugin.status === 'in-development' ? 'Learn more' :
    'Subscribe'
  )} &rarr;</span>
</a>
{showCart && gated && (buyable || (plugin.isFree && plugin.downloadUrl)) && (
  <button
    type="button"
    class="card-add"
    data-trial-gate-open
    data-plugin-name={plugin.name}
    data-plugin-slug={dlGateId(plugin)}
    data-register-url={registerUrl}
  >Free trial</button>
)}
{showCart && !gated && buyable && (
  <button
    type="button"
    class="card-add"
    data-add-to-cart
    data-slug={plugin.slug}
    data-name={plugin.name}
    data-price={plugin.regularPriceUsd ?? plugin.introPriceUsd}
    data-checkout-url={plugin.checkoutUrl}
  >Add to cart</button>
)}
{showCart && !gated && plugin.isFree && plugin.downloadUrl && (
  <a class="card-add" href={plugin.downloadUrl}>Download</a>
)}
</div>

<style>
  .plugin-card-wrap { position: relative; }

  /* Store grid: simple inline Add-to-cart button, sat in the footer row to the
     right of the card CTA. A sibling of the card <a> (never nested in it). */
  .card-add {
    position: absolute;
    right: 1.5rem;
    bottom: 1.4rem;
    z-index: 2;
    font-family: var(--font-display);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--bg-0);
    background: var(--brass);
    border: 1px solid var(--brass-dark);
    border-radius: 4px;
    padding: 0.45rem 0.8rem;
    cursor: pointer;
    transition: background 0.2s var(--ease), transform 0.15s var(--ease);
  }
  .card-add:hover { background: var(--brass-bright); }
  .card-add:active { transform: scale(0.96); }

  /* Phone tap target: grow the store "Add to cart" / "Download" chip to ≥44px
     tall without touching desktop (bench-tuned card stays pixel-identical). */
  @media (max-width: 900px) {
    .card-add {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0.6rem 1rem;
    }
  }

  .plugin-card {
    background: var(--bg-1);
    border: 1px solid var(--border);
    padding: 1.5rem;
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: inherit;
    position: relative;
  }

  .plugin-card:hover {
    border-color: var(--brass-dark);
    transform: translateY(-2px);
  }

  .status {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
    text-transform: uppercase;
  }
  .status.live { color: var(--emerald); }
  .status.beta { color: var(--brass); }
  .status.dev { color: var(--oxide); }

  .card-thumb {
    aspect-ratio: 2542 / 1226;
    background: #080808;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* Coming-soon plate: drop the dark screenshot frame so the plate floats on the
     card surface (no black side bars), and give the thumb the plate's OWN aspect
     ratio so the whole plate shows — no side bars, no top/bottom crop. */
  .card-thumb.is-plate {
    aspect-ratio: 1555 / 1060;
    background: none;
    border: 0;
    border-radius: 0;
    overflow: visible;
  }
  .card-thumb.is-plate img {
    filter: drop-shadow(0 7px 16px rgba(0, 0, 0, 0.55));
  }

  /* Bare: a real screenshot that isn't the wide RevLimiter-style desktop
     panel (e.g. a portrait knob shot) — float it at its own natural aspect
     ratio instead of letterboxing inside the wide dark box, which showed as
     black bars either side. */
  .card-thumb.is-bare {
    aspect-ratio: auto;
    background: none;
    border: 0;
    border-radius: 0;
    overflow: visible;
  }
  .card-thumb.is-bare img {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 7px 16px rgba(0, 0, 0, 0.55));
  }

  .thumb-placeholder {
    font-family: var(--font-display);
    letter-spacing: 0.1em;
    color: var(--fg-faint);
    font-size: 1.4rem;
  }

  h3 {
    font-size: 1.75rem;
    margin: 0;
    color: var(--brass-bright);
    text-align: center;
  }

  /* ── Per-plugin title colorways — mirrors PluginShowcase's carousel titles
     (same gradients, scaled-down strokes for the smaller card size). Spans are
     injected via set:html so they need :global. ── */
  .title-fx { color: #f0e6d2; font-family: var(--font-display); font-weight: 400; }
  .title-fx :global(.rev) { color: rgb(204, 26, 14); }
  .title-fx.drift {
    background: linear-gradient(115deg, #c08bff, #8b3cff 42%, #e23bff 78%, #ff6ad5);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 0 10px rgba(150, 60, 255, 0.35));
  }
  .title-fx :global(.acthe) { color: #f4f6f8; }
  .title-fx :global(.acac) {
    background: linear-gradient(180deg, #aef0ff, #43c6ff 55%, #2aa4e6);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 0 9px rgba(67, 198, 255, 0.4));
  }
  /* Fuel-filled glass tube (see PluginShowcase for the layer walkthrough) —
     static here, no sheen sweep: it's a grid of cards, five shimmering
     titles at once would read as noise. */
  .title-fx.gas {
    background:
      radial-gradient(circle 2px at 18% 72%, rgba(255, 236, 170, 0.85), transparent 70%),
      radial-gradient(circle 1.5px at 43% 85%, rgba(255, 236, 170, 0.7), transparent 70%),
      radial-gradient(circle 1.5px at 66% 64%, rgba(255, 236, 170, 0.75), transparent 70%),
      linear-gradient(180deg,
        rgba(206, 224, 234, 0.22) 0%,
        rgba(216, 232, 242, 0.32) 26%,
        rgba(255, 255, 255, 0.85) 31%,
        #ffd24a 35%,
        #ffa41f 52%,
        #f07000 74%,
        #a33f00 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    -webkit-text-stroke: 0.8px rgba(212, 236, 248, 0.38);
    filter: drop-shadow(0 0 8px rgba(255, 150, 30, 0.45));
  }
  .title-fx :global(.rr-red) {
    background: linear-gradient(180deg, #ff6157 0%, #d6232c 45%, #7e0d13 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    -webkit-text-stroke: 0.5px rgba(245, 235, 215, 0.3);
  }
  .title-fx :global(.rr-blk) {
    background: linear-gradient(180deg, #ffffff 0%, #c9ced6 10%, #565b63 34%, #1a1c20 62%, #0c0d10 84%, #31343a 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    -webkit-text-stroke: 0.5px rgba(255, 255, 255, 0.38);
  }

  .one-liner {
    font-size: 0.9rem;
    color: var(--fg-dim);
    margin: 0;
    text-align: center;
  }

  .prices {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .now {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--brass-bright);
    letter-spacing: 0.04em;
  }

  .now.muted-now { color: var(--fg-dim); }

  .was {
    font-family: var(--font-display);
    font-size: 1.425rem;
    color: var(--fg-faint);
    text-decoration: line-through;
    margin-left: -7px;
  }

  .pct {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--oxide-text);
    border: 1px solid var(--oxide);
    padding: 0.1rem 0.4rem;
  }

  .promo-hint {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--brass);
  }

  .hint { font-size: 0.85rem; }

  .bundle-hint {
    font-size: 0.78rem;
    color: var(--brass);
    margin: -0.25rem 0 0;
  }

  .more {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--fg);
    margin-top: 0.5rem;
  }
</style>
