---
/* Plugin showcase — page-leading carousel. The card is an ABSOLUTE stage that
   is pixel-identical to the card-design bench (/_cardbench): same 520-wide
   canvas, same section coordinates, same fonts. Whatever is dragged/tuned in
   the bench is applied here verbatim via the STYLE maps below — no flow-layout
   translation, so bench == production. Switching plays a gear-shift overshoot
   spring. Arrows + touch-swipe + keyboard + dots + a 6s auto-advance (in-view
   only, dies on first interaction) drive it. */
import { Image } from 'astro:assets';
import { bySlug } from '../data/plugins';
import arrowBtn from '../assets/showcase/arrow-btn.png';
import revlimiterShot from '../assets/plugins/revlimiter-hero.png';
import comingSoonPlate from '../assets/plugins/coming-soon-plate.png';
import gasShot from '../assets/plugins/gas-hero.png';
import radioRouletteShot from '../assets/plugins/radioroulette-hero.png';

const STAGE_W = 520;
const STAGE_H = 470;

// Style maps = the approved card-bench exports, applied verbatim.
const SLIDES = [
  {
    slug: 'revlimiter',
    name: 'RevLimiter',
    titleHtml: '<span class="rev">Rev</span>Limiter',
    titleClass: '',
    shot: revlimiterShot, shotAlt: 'RevLimiter plugin',
    catchphrase: 'Maximum loudness. Zero engine damage.',
    oneliner: 'The redline is your threshold. The needle is your gain reduction.',
    priceHtml: '$49<span class="sc-code"> · NEVER ON SALE</span>',
    style: {
      title:    { left: 70, top: 20,  ff: "'Bebas Neue', sans-serif", fw: 400, fs: 86, ls: 0 },
      sub:      { left: 73, top: 98,  ff: "'Bebas Neue', sans-serif", fw: 400, fs: 22, ls: 0 },
      shot:     { left: 49, top: 148 },
      oneliner: { left: 56, top: 358, ff: 'Rajdhani, sans-serif',     fw: 700, fs: 15, ls: 0 },
      price:    { left: 55, top: 382, ff: "'Bebas Neue', sans-serif", fw: 400, fs: 30, ls: 0 },
      more:     { left: 55, top: 422, ff: 'Oswald, sans-serif',       fw: 400, fs: 17, ls: 0 },
    },
  },
  {
    slug: 'gas',
    name: 'GAS',
    titleHtml: 'GAS',
    titleClass: 'gas',
    shot: gasShot, shotAlt: 'GAS plugin',
    shotFit: 'contain',
    catchphrase: 'One-knob saturation. Floor it.',
    oneliner: 'One DRIVE knob, three voices: Tube, Tape, Fuzz.',
    priceHtml: 'Free',
    style: {
      title:    { left: 0, top: 20,  ff: "'Bebas Neue', sans-serif", fw: 400, fs: 86, ls: 0 },
      sub:      { left: 0, top: 98,  ff: "'Bebas Neue', sans-serif", fw: 400, fs: 22, ls: 0 },
      // GAS's shot is a narrow portrait knob, not a wide desktop panel — sized
      // to its own 800:1190 aspect and centered, rather than the shared
      // 420×195 landscape box (which left huge dark flanks either side).
      shot:     { left: 191, top: 148, w: 138, h: 205 },
      oneliner: { left: 0, top: 358, ff: 'Rajdhani, sans-serif',     fw: 700, fs: 15, ls: 0 },
      price:    { left: 0, top: 382, ff: "'Bebas Neue', sans-serif", fw: 400, fs: 30, ls: 0 },
      more:     { left: 0, top: 422, ff: 'Oswald, sans-serif',       fw: 400, fs: 17, ls: 0 },
    },
  },
  {
    slug: 'the-ac',
    name: 'The AC',
    titleHtml: '<span class="acthe">THE</span> <span class="acac">AC</span>',
    titleClass: '',
    shot: comingSoonPlate, shotAlt: 'The AC, coming soon',
    catchphrase: 'Cold air for the top end.',
    oneliner: 'Add clean air and shine to your top end.',
    priceHtml: 'Target 2026',
    style: {
      title:    { left: 126, top: 19,  ff: "'Bebas Neue', sans-serif", fw: 400, fs: 86, ls: 0 },
      sub:      { left: 127, top: 102, ff: "'Bebas Neue', sans-serif", fw: 400, fs: 22, ls: 0 },
      shot:     { left: 49,  top: 148 },
      oneliner: { left: 57,  top: 356, ff: 'Rajdhani, sans-serif',     fw: 700, fs: 15, ls: 0 },
      price:    { left: 57,  top: 383, ff: "'Bebas Neue', sans-serif", fw: 400, fs: 25, ls: 0 },
      more:     { left: 56,  top: 419, ff: 'Oswald, sans-serif',       fw: 400, fs: 17, ls: 0 },
    },
  },
  {
    slug: 'drift',
    name: 'Drift',
    titleHtml: 'DRIFT',
    titleClass: 'drift',
    shot: comingSoonPlate, shotAlt: 'Drift, coming soon',
    catchphrase: 'Your sound, sliding. SKRRT!',
    oneliner: 'Send your selected freq. band to a trip across the stereo field.',
    priceHtml: 'Target 2026',
    style: {
      title:    { left: 132, top: 22,  ff: "'Bebas Neue', sans-serif", fw: 400, fs: 86, ls: 0 },
      sub:      { left: 135, top: 104, ff: "'Bebas Neue', sans-serif", fw: 400, fs: 22, ls: 0 },
      shot:     { left: 49,  top: 148 },
      oneliner: { left: 55,  top: 355, ff: 'Rajdhani, sans-serif',     fw: 700, fs: 15, ls: 0 },
      price:    { left: 54,  top: 384, ff: "'Bebas Neue', sans-serif", fw: 400, fs: 25, ls: 0 },
      more:     { left: 55,  top: 422, ff: 'Oswald, sans-serif',       fw: 400, fs: 17, ls: 0 },
    },
  },
  {
    slug: 'radio-roulette',
    name: 'Radio Roulette',
    // Roulette colorway: RADIO = plain cream (same as RevLimiter's "Limiter");
    // ROUL = pocket red, ETTE = pocket black (thin ivory stroke = the frets).
    titleHtml: 'RADIO <span class="rr-red">ROUL</span><span class="rr-blk">ETTE</span>',
    titleClass: '',
    shot: radioRouletteShot, shotAlt: 'Radio Roulette plugin',
    catchphrase: 'You’ll never know what’s next',
    oneliner: 'The station that never plays the same song twice.',
    priceHtml: '$19',
    style: {
      title:    { left: 0, top: 20,  ff: "'Bebas Neue', sans-serif", fw: 400, fs: 86, ls: 0 },
      sub:      { left: 0, top: 98,  ff: "'Bebas Neue', sans-serif", fw: 400, fs: 22, ls: 0 },
      shot:     { left: 49, top: 148 },
      oneliner: { left: 0, top: 358, ff: 'Rajdhani, sans-serif',     fw: 700, fs: 15, ls: 0 },
      price:    { left: 0, top: 382, ff: "'Bebas Neue', sans-serif", fw: 400, fs: 30, ls: 0 },
      more:     { left: 0, top: 422, ff: 'Oswald, sans-serif',       fw: 400, fs: 17, ls: 0 },
    },
  },
].filter((s) => {
  // Rotation carries ONLY buyable/downloadable plugins (conversion pass
  // 2026-08-03): a "Target 2026" slide in the homepage's prime slot sells
  // nothing and reads roadmap-company. Slide defs for in-development plugins
  // stay above with their bench-tuned styles — they re-enter the rotation by
  // themselves the day their status flips to live.
  const p = bySlug(s.slug);
  return p && p.status !== 'in-development';
});

const pos = (st: { left: number; top: number; w?: number; h?: number }) =>
  `left:${st.left}px;top:${st.top}px;` + (st.w ? `width:${st.w}px;` : '') + (st.h ? `height:${st.h}px;` : '');
// Text rows ignore their per-slide left and span the full stage, centered — only
// the vertical position is kept from the bench so the card reads as one centred stack.
const topf = (st: { top: number }) => `top:${st.top}px;`;
const font = (st: any) => (st.ff ? `font-family:${st.ff};font-weight:${st.fw};font-size:${st.fs}px;letter-spacing:${st.ls}px;` : '');

// Endless coverflow: every slide is classed by its SIGNED circular distance from
// the current one (0/±1 shown, everything else hidden) — see the matching go()
// logic in the script below. Computed here too so slide 0's neighbors already
// peek on first paint, no-JS included.
const n = SLIDES.length;
const peekClass = (i: number) => {
  let d = i % n;
  if (d > n / 2) d -= n;
  if (d < -n / 2) d += n;
  if (d === 0) return 'is-current';
  if (d === 1) return 'is-peek-next';
  if (d === -1) return 'is-peek-prev';
  return '';
};
---

{/* id="plugins" — scroll target for the hero's "See the plugins" secondary. */}
<section id="plugins" class="showcase-wrap" data-showcase tabindex="0" role="group" aria-roledescription="carousel" aria-label="RevAudio plugins">
  <div class="sr-only" aria-live="polite" aria-atomic="true" data-carousel-announce></div>
  <h2 class="sc-heading" data-reveal="fade">Our Plugins</h2>
  <div class="sc-scaler">
    <div class="showcase">
      <button type="button" class="sc-arrow sc-prev" aria-label="Previous plugin">
        <Image src={arrowBtn} alt="" width={240} loading="eager" />
      </button>

      <div class="sc-viewport">
        {SLIDES.map((s, i) => (
          <a
            class="sc-slide"
            class:list={[peekClass(i)]}
            href={`/${s.slug}`}
            data-slide
            aria-roledescription="slide"
            aria-label={`${s.name}, ${i + 1} of ${SLIDES.length}`}
          >
            <div class="sec sc-titlewrap" style={`top:${s.style.title.top}px`}>
              <span class={`sc-title ${s.titleClass}`} style={font(s.style.title)} set:html={s.titleHtml} />
            </div>
            <p class="sec sc-sub" style={topf(s.style.sub) + font(s.style.sub)}>{s.catchphrase}</p>
            <div class:list={['sec', 'sc-shot', { 'is-plate': [comingSoonPlate, radioRouletteShot].includes(s.shot), 'is-bare': s.shot === gasShot, 'sc-shot--fit': s.shotFit === 'contain' }]} style={pos(s.style.shot)}>
              <Image src={s.shot} alt={s.shotAlt} width={1600} widths={[480, 800, 1200, 1600]} sizes="(max-width: 640px) 92vw, 440px" format="webp" quality={92} loading="lazy" />
            </div>
            <p class="sec sc-one" style={topf(s.style.oneliner) + font(s.style.oneliner)}>{s.oneliner}</p>
            <span class="sec sc-price" style={topf(s.style.price) + font(s.style.price)} set:html={s.priceHtml}></span>
            <span class="sec sc-more" style={topf(s.style.more) + font(s.style.more)}>More Details &rarr;</span>
            {/* Rotated corner ribbon (e.g. GAS's bundle freebie) — top-right,
                tilted so the left edge reads higher than the right (a "\"
                slant), independent of the left/top style-map grid above. */}
            {s.badge && (
              <div class="sc-badge">
                {s.badge.map((line) => <span>{line}</span>)}
              </div>
            )}
          </a>
        ))}
      </div>

      <button type="button" class="sc-arrow sc-next" aria-label="Next plugin">
        <Image src={arrowBtn} alt="" width={240} loading="eager" />
      </button>
    </div>
  </div>

  <div class="sc-dots" data-dots>
    {SLIDES.map((_, i) => (
      <button type="button" class="sc-dot" class:list={[{ active: i === 0 }]} data-dot={i} aria-label={`Go to slide ${i + 1}`}></button>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((sc) => {
    const slides = Array.from(sc.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(sc.querySelectorAll<HTMLElement>('[data-dot]'));
    const viewport = sc.querySelector<HTMLElement>('.sc-viewport');
    const showcase = sc.querySelector<HTMLElement>('.showcase');
    const scaler = sc.querySelector<HTMLElement>('.sc-scaler');
    const announce = sc.querySelector<HTMLElement>('[data-carousel-announce]');
    if (!viewport || !showcase || !scaler || slides.length === 0) return;
    const n = slides.length;
    let idx = 0;

    // Endless coverflow: every slide is classed by its SIGNED circular distance
    // from idx (0 = current, ±1 = peeking neighbor, everything else hidden).
    // No "direction" bookkeeping needed — wrapping from last→first (or back)
    // is just distance -1/+1 like any other neighbor, so the loop is seamless.
    const signedDist = (k: number) => {
      let d = (k - idx) % n;
      if (d > n / 2) d -= n;
      if (d < -n / 2) d += n;
      return d;
    };

    // announceChange=false for auto-advance — the aria-live region must not
    // narrate every 6 seconds at a screen-reader user.
    const go = (target: number, announceChange = true) => {
      const next = ((target % n) + n) % n;
      if (next === idx) return;
      idx = next;
      slides.forEach((s, k) => {
        s.classList.remove('is-current', 'is-peek-prev', 'is-peek-next');
        const d = signedDist(k);
        if (d === 0) s.classList.add('is-current');
        else if (d === 1) s.classList.add('is-peek-next');
        else if (d === -1) s.classList.add('is-peek-prev');
      });
      dots.forEach((d, k) => d.classList.toggle('active', k === idx));
      if (announceChange && announce) announce.textContent = slides[idx].getAttribute('aria-label') ?? '';
      // GAS fuel slosh: every carousel move rocks the liquid in the letters.
      // Remove + reflow + re-add so the one-shot animation restarts even on
      // rapid consecutive moves. (reduced-motion users: no slosh.)
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        sc.querySelectorAll<HTMLElement>('.sc-title.gas').forEach((t) => {
          t.classList.remove('is-slosh');
          void t.offsetWidth;
          t.classList.add('is-slosh');
        });
      }
    };

    sc.querySelector('.sc-prev')?.addEventListener('click', () => { killAuto(); go(idx - 1); });
    sc.querySelector('.sc-next')?.addEventListener('click', () => { killAuto(); go(idx + 1); });
    dots.forEach((d, k) => d.addEventListener('click', () => { killAuto(); go(k); }));

    // Peeking neighbors are clickable shortcuts to bring them to center —
    // the current slide keeps its plain navigate-to-product-page behavior.
    slides.forEach((s, k) => {
      s.addEventListener('click', (e) => {
        if (s.classList.contains('is-peek-prev') || s.classList.contains('is-peek-next')) {
          e.preventDefault();
          killAuto();
          go(k);
        }
      });
    });

    sc.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { killAuto(); go(idx - 1); e.preventDefault(); }
      if (e.key === 'ArrowRight') { killAuto(); go(idx + 1); e.preventDefault(); }
    });

    // swipe; suppress the click after a real drag so it never navigates
    let downX: number | null = null;
    let moved = false;
    viewport.addEventListener('pointerdown', (e) => { downX = e.clientX; moved = false; });
    viewport.addEventListener('pointermove', (e) => { if (downX !== null && Math.abs(e.clientX - downX) > 10) moved = true; });
    viewport.addEventListener('pointerup', (e) => {
      if (downX !== null) {
        const dx = e.clientX - downX;
        if (Math.abs(dx) > 40) { killAuto(); go(dx < 0 ? idx + 1 : idx - 1); }
      }
      downX = null;
    });
    viewport.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);

    // ── shared in-view observer: one-time arrow glint now; auto-advance
    //    (Task 5) registers via onInView. ──
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let inView = false;
    const onInView: Array<() => void> = [];
    let glinted = false;
    const io = new IntersectionObserver((entries) => {
      inView = entries[0].isIntersecting;
      if (!inView) return;
      if (!glinted && !reduced) {
        glinted = true;
        sc.querySelectorAll('.sc-arrow').forEach((a) => a.classList.add('is-glint'));
      }
      onInView.forEach((f) => f());
    }, { threshold: 0.35 });
    io.observe(sc);

    // ── auto-advance REMOVED 2026-08-03 (conversion pass): a timer that flips
    //    the slide mid-read takes the product away from whoever's looking at
    //    it, and timed motion is what banner-blindness filters. The visitor
    //    drives — arrows, dots, keys, swipe. killAuto stays as a no-op seam
    //    for the interaction handlers that used to retire the timer. ──
    const killAuto = () => {};

    // Uniformly scale the fixed bench-exact stage to fit width — all
    // viewports. On phones this shrinks the whole coverflow (card + peeking
    // neighbors) instead of switching to a single static full-width card,
    // so the carousel reads as a carousel (Dan, 2026-07-21 design review).
    const fit = () => {
      // Reset BOTH the transform and the scaler's pinned height before
      // measuring — .sc-scaler is a flex parent, so a stale fixed height from
      // the previous fit() stretches .showcase and feeds back into ih.
      showcase.style.transform = 'none';
      showcase.style.height = 'auto';
      scaler.style.height = 'auto';
      const iw = showcase.offsetWidth;
      const ih = showcase.offsetHeight;
      // Pin the stage to its measured height BEFORE scaling — otherwise the
      // scaler's fixed height stretches .showcase shorter (flex), and the
      // fixed-470px viewport centers itself above the stage top.
      showcase.style.height = `${ih}px`;
      const availW = sc.clientWidth;
      // Height cap: full card + dots should fit the viewport under the sticky
      // nav — all measured live (nav, section heading, dots row) so viewport-
      // scaled type stays accounted for. Floored at 0.7 — below that
      // legibility loses to just scrolling. The floor applies to the HEIGHT
      // cap only; the width cap stays exact so narrow-but-tall windows never
      // overflow horizontally.
      const headerH = (document.querySelector('.site-nav') as HTMLElement | null)?.getBoundingClientRect().height ?? 64;
      const headingEl = sc.querySelector<HTMLElement>('.sc-heading');
      const headingH = headingEl
        ? headingEl.getBoundingClientRect().height + parseFloat(getComputedStyle(headingEl).marginTop || '0')
        : 0;
      const dotsH = (sc.querySelector('.sc-dots') as HTMLElement | null)?.getBoundingClientRect().height ?? 24;
      // Two flex gaps in the section column (heading→stage, stage→dots),
      // measured; 12 = breathing room.
      const gapH = (parseFloat(getComputedStyle(sc).rowGap) || 20) * 2;
      const availH = window.innerHeight - headerH - headingH - dotsH - gapH - 12;
      // Phones: cap the card to ~76% of the row so the coverflow neighbors
      // actually peek inside the screen — the visible cue that this swipes.
      const widthCap = window.innerWidth <= 640 ? (availW * 0.76) / iw : availW / iw;
      const s = Math.min(1, widthCap, Math.max(0.7, availH / ih));
      showcase.style.transform = `scale(${s})`;
      showcase.style.transformOrigin = 'top center';
      scaler.style.height = `${ih * s}px`;
    };
    window.addEventListener('resize', fit);
    fit();
    window.addEventListener('load', fit);
  });
</script>

<style>
  /* Visually hidden but available to screen readers */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .showcase-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    padding: 0.48rem 1rem 2.4rem;
    overflow-x: clip;
    outline: none;
  }

  .sc-heading {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 7vw, 4.8rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg);
    text-align: center;
    margin: 0;
    padding-top: 0.5rem;
    width: 100%;
  }
  .sc-scaler { display: flex; justify-content: center; width: 100%; }

  .showcase {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Arrows sit well clear of the peeking neighbor cards, out toward the
       edges of the section rather than hugging the current card. */
    gap: clamp(2rem, 11vw, 9rem);
  }

  /* ── fixed stage; sections absolutely placed (identical to the bench) ── */
  .sc-viewport { position: relative; width: 520px; height: 470px; perspective: 1300px; flex: 0 0 auto; touch-action: pan-y; }

  .sc-slide {
    position: absolute;
    inset: 0;
    display: block;
    color: inherit;
    text-decoration: none;
    transform-origin: center;
    /* Gear-shift snap: fast slide with an overshoot-and-settle spring — the
       incoming card clunks into place. */
    transition: transform 0.4s cubic-bezier(0.34, 1.3, 0.35, 1), opacity 0.3s ease, filter 0.3s ease;
    will-change: transform, opacity;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 1;
    /* Resting "hidden" position for anything past the peeking neighbors —
       parked small/centered/invisible; only reachable via a multi-step dot
       jump, so it just fades/grows into place rather than sliding from a
       specific side. */
    transform: scale(0.55);
    /* card frame — machined-brass edge + faint textured face. Two-layer
       background: face gradient clipped to padding-box, brass gradient clipped
       to border-box showing through the transparent 1px border. Brighter at
       the top (light catch), darkening down. No extra DOM — bench coordinate
       space untouched. */
    border: 1px solid transparent;
    background:
      repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.012) 0 2px, transparent 2px 6px) padding-box,
      linear-gradient(180deg, #17130d 0%, var(--bg-1) 42%, #0d0b08 100%) padding-box,
      linear-gradient(180deg, #d9b36a 0%, #8a6a33 28%, #453518 62%, #6e5527 100%) border-box;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.55);
  }
  /* Soft radial glow grounding the shot region (shot box sits at ~148–343px
     on the 470px stage). First in the tree → paints under every .sec. */
  .sc-slide::before {
    content: "";
    position: absolute;
    left: 30px;
    right: 30px;
    top: 130px;
    height: 240px;
    background: radial-gradient(ellipse 60% 55% at 50% 50%, rgba(255, 170, 60, 0.07), transparent 70%);
    pointer-events: none;
  }
  .sc-slide.is-current { opacity: 1; visibility: visible; pointer-events: auto; transform: none; filter: none; z-index: 3; }
  /* Endless coverflow: the immediate neighbors rest permanently visible,
     scaled down and blurred, peeking in from either side — not just mid-
     transition. Clicking one brings it to center (see script above); the
     wrap from last→first is just distance -1/+1 like any other pair, so
     the loop reads as one continuous ring. */
  .sc-slide.is-peek-prev,
  .sc-slide.is-peek-next {
    visibility: visible;
    opacity: 0.55;
    pointer-events: auto;
    z-index: 2;
    /* Dim + desaturate instead of blur — the neighbors read as real, legible
       cards waiting in the wings, not out-of-focus smudges. */
    filter: saturate(0.55) brightness(0.7);
    cursor: pointer;
  }
  .sc-slide.is-peek-prev { transform: translateX(-58%) scale(0.8) rotateY(14deg); }
  .sc-slide.is-peek-next { transform: translateX(58%) scale(0.8) rotateY(-14deg); }
  .sc-slide.is-peek-prev:hover,
  .sc-slide.is-peek-next:hover { opacity: 0.85; filter: saturate(0.9) brightness(0.9); }
  /* border-color can't show through the border-box gradient — glow instead */
  .sc-slide.is-current:hover { box-shadow: 0 12px 48px rgba(0, 0, 0, 0.55), 0 0 20px rgba(255, 170, 60, 0.14); }

  .sec { position: absolute; }

  /* Emblems removed — title sits centered across the full stage width. */
  .sc-titlewrap { left: 0; width: 100%; display: flex; align-items: center; justify-content: center; }
  .sc-title { line-height: 1; white-space: nowrap; color: #f0e6d2; }
  /* :global — the .rev/.acthe/.acac spans are injected via set:html, so they
     carry no Astro scope hash; scoped selectors would miss them. */
  /* Deep brand red, lifted from rgb(146,3,1) (2:1 on the stage) to clear WCAG
     1.4.3 large-text 3:1 on --bg-1 while staying in the oxide/blood-red family. */
  .sc-title :global(.rev) { color: rgb(204, 26, 14); }
  .sc-title.drift {
