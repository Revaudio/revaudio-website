---
const year = new Date().getFullYear();

/* Site map, grouped. The footer is deliberately a superset of the header —
   repeating Store/Support/About here is the convention, and the column
   headings are what stop the repetition reading as a duplicate nav bar.
   `legal` links open the in-page modal (delegated handler in Cart.astro);
   the href stays a real page so no-JS and new-tab still work. */
const columns = [
  {
    title: 'Products',
    links: [
      { label: 'Store', href: '/store' },
      {
        label: 'Downloads',
        href: 'https://revlimiter-license.revaudio.workers.dev/download',
        external: true,
      },
      { label: 'RevBeta', href: '/beta' },
    ],
  },
  {
    title: 'Support',
    links: [
      { label: 'Support', href: '/support' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Affiliates', href: '/affiliate' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'T&C', href: '/terms', legal: 'terms' },
      { label: 'Licence', href: '/eula', legal: 'eula' },
      { label: 'Privacy', href: '/privacy', legal: 'privacy' },
      { label: 'Accessibility', href: '/accessibility' },
    ],
  },
];

/* Same five accounts and the same glyph paths as the plugins' info panel
   (Source/ui/public/index.html, .ip-soc data-soc-url) — keep both in sync. */
const socials = [
  {
    label: '@revaudioplugins on Instagram (opens in new tab)',
    href: 'https://www.instagram.com/revaudioplugins',
    path: 'M12 2.2c3.2 0 3.6 0 4.85.06 3.25.15 4.77 1.69 4.92 4.92.06 1.26.07 1.63.07 4.82s-.01 3.56-.07 4.82c-.15 3.23-1.66 4.77-4.92 4.92-1.25.06-1.62.07-4.85.07s-3.6-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.93C2.17 15.56 2.16 15.19 2.16 12s.01-3.56.07-4.82C2.38 3.95 3.9 2.41 7.15 2.26 8.4 2.21 8.8 2.2 12 2.2zm0 3.3a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zm0 2.3a4.2 4.2 0 1 1 0 8.4 4.2 4.2 0 0 1 0-8.4zm6.7-2.6a1.52 1.52 0 1 0 0 3.04 1.52 1.52 0 0 0 0-3.04z',
  },
  {
    label: '@RevAudioPlugins on YouTube (opens in new tab)',
    href: 'https://www.youtube.com/@RevAudioPlugins',
    path: 'M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z',
  },
  {
    label: '@revaudioplugins on TikTok (opens in new tab)',
    href: 'https://www.tiktok.com/@revaudioplugins',
    path: 'M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z',
  },
  {
    label: '@revaudioplugins on X (opens in new tab)',
    href: 'https://x.com/revaudioplugins',
    path: 'M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64z',
  },
  {
    label: 'RevAudio on Facebook (opens in new tab)',
    href: 'https://www.facebook.com/profile.php?id=61591226475818',
    path: 'M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.9h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94z',
  },
];
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <nav class="footer-cols" aria-label="Footer navigation">
      {columns.map((col) => (
        <div class="footer-col">
          <h2 class="footer-col-title">{col.title}</h2>
          <ul>
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  data-open-legal={link.legal}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <div class="footer-bar">
      <div class="footer-brand">
        <span class="logo">REV<span style="color: var(--brass-bright)">AUDIO</span></span>
        <span class="footer-copy">&copy; {year} RevAudio. All rights reserved.</span>
      </div>
      <ul class="footer-social">
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d={s.path} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
