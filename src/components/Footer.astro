---
const year = new Date().getFullYear();

/* Site map, grouped. The footer is deliberately a superset of the header —
   repeating Store/Support/About here is the convention, and the column
   headings are what stop the repetition reading as a duplicate nav bar.
   `legal` links open the in-page modal (delegated handler in Cart.astro);
   the href stays a real page so no-JS and new-tab still work. */
const columns = [
  {
    title: 'Products',
    links: [
      { label: 'Store', href: '/store' },
      {
        label: 'Downloads',
        href: 'https://revlimiter-license.revaudio.workers.dev/download',
        external: true,
      },
      { label: 'RevBeta', href: '/beta' },
    ],
  },
  {
    title: 'Support',
    links: [
      { label: 'Support', href: '/support' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Affiliates', href: '/affiliate' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'T&C', href: '/terms', legal: 'terms' },
      { label: 'Licence', href: '/eula', legal: 'eula' },
      { label: 'Privacy', href: '/privacy', legal: 'privacy' },
      { label: 'Accessibility', href: '/accessibility' },
    ],
  },
];
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <nav class="footer-cols" aria-label="Footer navigation">
      {columns.map((col) => (
        <div class="footer-col">
          <h2 class="footer-col-title">{col.title}</h2>
          <ul>
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  data-open-legal={link.legal}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <div class="footer-bar">
      <div class="footer-brand">
        <span class="logo">REV<span style="color: var(--brass-bright)">AUDIO</span></span>
        <span class="footer-copy">&copy; {year} RevAudio. All rights reserved.</span>
      </div>
      <ul class="footer-social">
        <li>
          <a
            href="https://instagram.com/revaudio"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="@revaudio on Instagram (opens in new tab)"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
              <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
              <circle cx="17.2" cy="6.8" r="1.3" fill="currentColor" />
            </svg>
          </a>
        </li>
        <li>
          <a
            href="https://youtube.com/@revaudio"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="@revaudio on YouTube (opens in new tab)"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="2" />
              <path d="M10.2 9.3v5.4l4.6-2.7z" fill="currentColor" />
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
