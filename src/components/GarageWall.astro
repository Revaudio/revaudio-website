---
/* GarageWall — the back wall of the shop as a section wrapper.
   Same wood + brass cap rails + warm top light + AA scrim as the product
   page's .garage-wall ([slug].astro, Dan-approved 2026-07-29), lifted into a
   reusable wrapper so the homepage hangs its sections on the same wall
   (design-language Law 7: same garage). Whatever goes in the slot sits ON
   the wall; the --engrave / --engrave-fine tokens cascade down so slotted
   headings can route themselves into the board with
   `text-shadow: var(--engrave)`.

   Layers (isolated stacking context, bottom → top):
     .wall-wood  z:-2  the drifting wood tile (data-drift-y, overscans ±32px)
     ::before    z:-1  warm top rake + contrast scrim (THE AA dial)
     ::after     z:-1  the two cap rails + the top rail's cast shadow
     .gw-inner   z:0   content, padded clear of the rails

   Full-bleed via the 100vw/translateX(-50%) trick — safe because html+body
   carry overflow-x: clip. Nothing here is pixel-positioned. */
import wallImg from '../assets/bg/wall-wood.png';
import railImg from '../assets/bg/wall-rail.png';

interface Props {
  id?: string;
  ariaLabel?: string;
}
const { id, ariaLabel } = Astro.props;
---

<section
  class="garage-wall"
  id={id}
  aria-label={ariaLabel}
  style={`--wall-url:url(${wallImg.src});--rail-url:url(${railImg.src});`}
>
  <div class="wall-art" aria-hidden="true">
    <div class="wall-wood" data-drift-y="24"></div>
  </div>
  <div class="gw-inner">
    <slot />
  </div>
</section>

<style>
  .garage-wall {
    position: relative;
    isolation: isolate;
    --rail-h: 30px;

    /* Type routed INTO the board — dark lip up, raw-timber lip down, hard
       edges, ≤2px offsets. Verbatim from [slug].astro; see the essay there
       before touching these numbers. */
    --engrave:
      0 -2px 0 rgba(0, 0, 0, 1),
      0 2px 0 rgba(198, 156, 104, 0.75),
      0 4px 8px rgba(0, 0, 0, 0.75);
    --engrave-fine:
      0 -1px 0 rgba(0, 0, 0, 1),
      0 1px 0 rgba(198, 156, 104, 0.6);
  }

  /* static plate: top light + scrim */
  .garage-wall::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(255, 214, 150, 0.07) 0%, rgba(255, 214, 150, 0) 32%),
      linear-gradient(rgba(11, 10, 9, 0.38), rgba(11, 10, 9, 0.38));
  }

  /* the moving wood — outer clips, inner overscans and carries the drift */
  .wall-art {
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    z-index: -2;
    overflow: hidden;
    pointer-events: none;
  }
  .wall-wood {
    position: absolute;
    inset: -32px 0;
    background: var(--wall-url) top center / 512px auto repeat;
    will-change: transform;
  }

  /* cap rails top + bottom, static while the wood drifts behind them */
  .garage-wall::after {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    z-index: -1;
    pointer-events: none;
    background:
      var(--rail-url) top center / auto var(--rail-h) repeat-x,
      linear-gradient(180deg, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0)) top center / 100% calc(var(--rail-h) * 2) no-repeat,
      var(--rail-url) bottom center / auto var(--rail-h) repeat-x;
    box-shadow: 0 14px 26px rgba(0, 0, 0, 0.6);
  }

  /* content clears the rails; sections add their own breathing room inside */
  .gw-inner {
    position: relative;
    padding-block: calc(var(--rail-h) + 0.5rem);
  }

  @media (max-width: 480px) {
    .garage-wall { --rail-h: 22px; }
  }

  /* high contrast: the photographic layers go, the section keeps its edges */
  :global(html.hc) .wall-art,
  :global(html.hc) .garage-wall::after { display: none; }
  :global(html.hc) .garage-wall::before {
    background: var(--bg-1);
    border-top: 1px solid var(--border-bright);
    border-bottom: 1px solid var(--border-bright);
  }
</style>
