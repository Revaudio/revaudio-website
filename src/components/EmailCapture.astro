---
interface Props {
  heading?: string;
  subhead?: string;
  buttonLabel?: string;
  id?: string;
}

const {
  // Offer-first defaults (conversion pass 2026-08-03): "Subscribe to the
  // newsletter" is the weakest framing in the category, and live competitor
  // audit found zero brands saying "No spam" — permission language instead.
  heading = 'Join the pit crew',
  subhead = 'Early plugin drops, demo codes, and intro pricing, straight to your inbox. Unsubscribe anytime.',
  buttonLabel = 'Sign me up',
  id,
} = Astro.props;

// GO LIVE: paste the Formspree form id in src/data/site.ts (single source for
// this form AND the hero subscribe modal). Until then the form won't pretend
// to capture — it shows an honest notice.
import { site } from '../data/site';

const endpoint = site.formspreeEndpoint;
---

<section class="signup" id={id}>
  <div class="container" data-reveal>
    <h2>{heading}</h2>
    <p>{subhead}</p>
    <form class="signup-form" action={endpoint} method="POST" data-newsletter>
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        id="newsletter-email"
        type="email"
        name="email"
        placeholder="you@studio.com"
        required
        autocomplete="email"
      />
      <!-- honeypot: real users never fill this; bots do -->
      <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button type="submit" class="signup-submit">
        <span class="ss-face">{buttonLabel} <span class="ss-arrow">&#9656;</span></span>
      </button>
    </form>
    <p class="signup-status" role="status" aria-live="polite" hidden></p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    const status = form.parentElement?.querySelector<HTMLElement>('.signup-status');
    // Build-time placeholder still in the action ⇒ not wired to a real backend yet.
    const wired = !form.action.includes('REPLACE_WITH_FORM_ID');

    const show = (msg: string, ok: boolean) => {
      if (!status) return;
      status.textContent = msg;
      status.hidden = false;
      status.classList.toggle('ok', ok);
      status.classList.toggle('err', !ok);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!wired) {
        show('Almost there. Newsletter signup goes live shortly. Your email wasn’t sent yet.', false);
        return;
      }
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.hidden = true;
          show('You’re on the list. Watch your inbox for the first build.', true);
        } else {
          show('Something went wrong. Try again, or email info@revaudio.net.', false);
        }
      } catch {
        show('Network hiccup. Try again in a moment.', false);
      }
    });
  });
</script>

<style>
  /* Flat brass button, same language as TrialStamp's .tc-submit / .btn.primary.
     Replaces the btn-submit image plate — that plate had to be stacked under
     the input because it cropped beside it; a text button sits on the row. */
  .signup form { align-items: stretch; gap: 0.5rem; }

  .signup .signup-form .signup-submit {
    flex: none;
    padding: 0.875rem 1.5rem;
    background: var(--brass);
    color: var(--bg-0);
    border: 1px solid transparent;
    border-radius: 6px;
    cursor: pointer;
    font: inherit;
    transition: background 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  .signup .signup-form .ss-face {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 1;
  }

  .signup .signup-form .ss-arrow { color: var(--bg-1); opacity: 0.7; }

  .signup .signup-form .signup-submit:hover {
    background: var(--brass-bright);
    box-shadow: 0 0 24px rgba(232, 200, 120, 0.35);
  }

  .signup .signup-form .signup-submit:focus-visible {
    outline: 2px solid var(--brass-bright);
    outline-offset: 2px;
  }
  /* honeypot — visually and semantically hidden, still submittable by bots */
  .signup form .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .signup .signup-status {
    margin: 1.25rem auto 0;
    max-width: 480px;
    font-size: 0.95rem;
  }
  .signup .signup-status.ok { color: var(--brass-bright); }

  /* The one allowed confirmation accent (motion plan): soft settle-pop on the
     success message. Gated on motion-ok so reduced-motion/no-JS stay static.
     Overshoot bezier ≈ back.out, kept under the 8% bible ceiling. */
  :global(html.motion-ok) .signup .signup-status.ok {
    animation: status-pop 0.45s cubic-bezier(0.34, 1.35, 0.64, 1) both;
  }

  @keyframes status-pop {
    from { opacity: 0; transform: scale(0.92) translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  .signup .signup-status.err { color: var(--fg-dim); }
  /* Under 480px the global rule stacks the form; centre the button there so it
     doesn't stretch the full input width. */
  @media (max-width: 480px) {
    .signup .signup-form .signup-submit { align-self: center; min-width: 180px; }
  }
</style>
