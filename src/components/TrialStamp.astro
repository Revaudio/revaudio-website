---
/* TrialStamp — on-page free-trial email capture, desktop only.
   Was a patch/sticker link beside the h1 that scrolled to #trial (TrialPlates);
   relocated by Dan (2026-07-26) into the gap under the product screenshot,
   next to the crane door's checkout box, as a real inline capture row —
   input + button, simple flat-then-3D button (same language as the GAS
   exit-popup CTA / .btn.primary), no torn-patch art, no worn-ink filter.

   NOT wired to a backend yet — Yoni owns the worker integration
   (POST {origin of plugin.trialUrl}/download/register, same contract as
   TrialPlates.astro). Submit is a no-op that shows an honest "coming soon"
   status line, same convention as EmailCapture.astro's unwired state.

   Mobile: hidden — the door's own "or try it free for 14 days" link
   (BuyButtonCrane's .rc-trial) and MobileBuyBar already carry the trial
   funnel on phones. */
import type { Plugin } from '../data/plugins';

interface Props {
  plugin: Plugin;
}

const { plugin } = Astro.props;
---

<div class="trial-cta" data-trial-cta>
  <p class="tc-label">Get your <em>free</em> 14-day trial</p>
  <form class="tc-form" data-trial-cta-form novalidate>
    <label for="trial-cta-email" class="sr-only">Your email</label>
    <input
      id="trial-cta-email"
      class="tc-email"
      type="email"
      inputmode="email"
      autocomplete="email"
      enterkeyhint="go"
      spellcheck="false"
      placeholder="your@email.com"
      aria-label={`Your email, we send the ${plugin.name} download link here`}
    >
    <button type="submit" class="tc-submit" aria-label="Get the download link">
      <span class="tc-face">Get it <span class="tc-arrow">&#9656;</span></span>
    </button>
  </form>
  <p class="tc-status" data-trial-cta-status role="status" aria-live="polite" hidden></p>
  <p class="tc-micro">Full version &middot; no credit card</p>
</div>

<style>
  /* Sized 1.5× the original pass (Dan, 2026-07-26): tripled once, then halved
     back down. box-shadow blur/offsets scaled with them so the bevel still
     reads correct at this size. */
  .trial-cta {
    display: none;               /* desktop-only — see @media (min-width: 901px) */
    width: 100%;
    max-width: 540px;
    margin-top: 2.6rem;
  }

  @media (min-width: 901px) {
    .trial-cta { display: block; }
  }

  .tc-label {
    font-family: var(--font-display);
    font-size: 1.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg);
    margin: 0 0 0.9rem;
  }
  .tc-label em { font-style: normal; color: var(--brass-bright); }

  .tc-form {
    display: flex;
    gap: 0.9rem;
  }

  .tc-email {
    flex: 1;
    min-width: 0;
    padding: 1.05rem 1.3rem;
    background: var(--bg-1);
    color: var(--fg);
    border: 1px solid var(--border-bright);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 1.35rem;
  }
  .tc-email::placeholder { color: var(--fg-faint); }
  .tc-email:focus {
    outline: none;
    border-color: var(--brass);
  }

  /* the button — flat brass fill, same language as the GAS exit-popup CTA
     (.eg-cta) / BuyButton's .btn.primary. No gradient, no bevel. */
  .tc-submit {
    flex: none;
    padding: 1.05rem 1.65rem 0.9rem;
    text-align: center;
    background: var(--brass);
    color: var(--bg-0);
    border: 1px solid transparent;
    border-radius: 6px;
    transition: background 0.2s var(--ease), box-shadow 0.2s var(--ease);
    cursor: pointer;
    font: inherit;
  }

  .tc-face {
    display: block;
    font-family: var(--font-display);
    font-size: 1.575rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 1;
  }
  .tc-arrow { color: var(--bg-1); opacity: 0.7; }

  .tc-submit:hover {
    background: var(--brass-bright);
    box-shadow: 0 0 24px rgba(232, 200, 120, 0.35);
  }
  .tc-submit:focus-visible { outline: 2px solid var(--brass-bright); outline-offset: 2px; }

  .tc-status {
    font-family: var(--font-mono);
    font-size: 1.17rem;
    color: var(--fg-dim);
    margin: 0.9rem 0 0;
  }

  .tc-micro {
    font-family: var(--font-mono);
    font-size: 1.02rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin: 0.75rem 0 0;
  }
</style>

<script>
  // UI ONLY — no backend wired yet (Yoni owns the license-worker integration:
  // POST {origin of plugin.trialUrl}/download/register, same contract as
  // TrialPlates.astro). Submit shows an honest "not live yet" status instead
  // of silently doing nothing or pretending to succeed.
  document.querySelectorAll<HTMLFormElement>('[data-trial-cta-form]').forEach((form) => {
    const status = form.parentElement?.querySelector<HTMLElement>('[data-trial-cta-status]');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!status) return;
      status.textContent = 'Almost there — the free trial goes live shortly.';
      status.hidden = false;
    });
  });
</script>
